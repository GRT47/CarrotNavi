<?xml version="1.0" encoding="utf-8"?>
<!-- expanded_top_tbt 가로 모드: root match_parent×match_parent, crossroad 320dp×0dp, first_tbt 320dp×67dp -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/crossroad"
        layout="@layout/navigation_expanded_crossroad"
        android:layout_width="@dimen/tmap_320dp"
        android:layout_height="@dimen/tmap_0dp"
        android:layout_marginTop="-13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/first_tbt" />

    <include
        android:id="@+id/first_tbt"
        layout="@layout/navigation_expanded_first_top_tbt"
        android:layout_width="@dimen/tmap_320dp"
        android:layout_height="@dimen/tmap_67dp"
        app:layout_constraintBottom_toTopOf="@id/crossroad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <include
        android:id="@+id/second_tbt"
        layout="@layout/navigation_second_top_tbt"
        android:layout_width="@dimen/tmap_128dp"
        android:layout_height="@dimen/tmap_56dp"
        android:layout_marginTop="-11.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/first_tbt"
        app:layout_constraintVertical_bias="0" />
</androidx.constraintlayout.widget.ConstraintLayout>
