<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/crossroad_image_view"
        android:layout_width="@dimen/tmap_0dp"
        android:layout_height="@dimen/tmap_0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1.6:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:src="@tools:sample/avatars" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/short_shadow_image_view"
        android:layout_width="@dimen/tmap_0dp"
        android:layout_height="@dimen/tmap_4dp"
        android:src="@drawable/navigation_expanded_crossroad_short_shadow"
        app:layout_constraintEnd_toEndOf="@id/crossroad_image_view"
        app:layout_constraintStart_toStartOf="@id/crossroad_image_view"
        app:layout_constraintTop_toBottomOf="@id/crossroad_image_view" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/long_shadow_image_view"
        android:layout_width="@dimen/tmap_0dp"
        android:layout_height="@dimen/tmap_6dp"
        android:src="@drawable/navigation_expanded_crossroad_long_shadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/crossroad_image_view"
        app:layout_constraintStart_toStartOf="@id/crossroad_image_view"
        app:layout_constraintTop_toBottomOf="@id/crossroad_image_view" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/shrink_image_view"
        android:layout_width="@dimen/tmap_54dp"
        android:layout_height="@dimen/tmap_54dp"
        android:background="@null"
        android:padding="@dimen/tmap_12dp"
        android:src="@drawable/navigation_crossroad_shrink_button"
        app:layout_constraintBottom_toBottomOf="@id/crossroad_image_view"
        app:layout_constraintEnd_toEndOf="@id/crossroad_image_view"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@id/crossroad_image_view"
        app:layout_constraintTop_toTopOf="@id/crossroad_image_view"
        app:layout_constraintVertical_bias="1" />
</androidx.constraintlayout.widget.ConstraintLayout>
