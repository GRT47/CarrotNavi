<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/tmap_256dp"
    android:layout_height="@dimen/tmap_112dp"
    android:background="@drawable/navigation_normal_first_top_tbt_background"
    android:paddingStart="@dimen/tmap_8dp"
    android:paddingEnd="@dimen/tmap_32dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_image_view"
        android:layout_width="@dimen/tmap_64dp"
        android:layout_height="@dimen/tmap_64dp"
        android:layout_marginTop="@dimen/tmap_11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/distance_value_text_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:src="@drawable/navigation_tbt_arrow_01_icon" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/distance_value_text_view"
        style="@style/Tbt.First.Top.Distance.Value.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tmap_8dp"
        android:layout_marginTop="@dimen/tmap_6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/name_text_view"
        app:layout_constraintEnd_toStartOf="@id/distance_unit_text_view"
        app:layout_constraintStart_toEndOf="@id/icon_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        tools:ignore="SpUsage"
        tools:text="350" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/distance_unit_text_view"
        style="@style/Tbt.First.Top.Distance.Unit.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tmap_2dp"
        android:layout_marginBottom="@dimen/tmap_2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/distance_value_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/distance_value_text_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        tools:ignore="SpUsage"
        tools:text="m" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/name_text_view"
        style="@style/Tbt.First.Top.Name.Normal"
        android:layout_width="@dimen/tmap_0dp"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/distance_value_text_view"
        app:layout_constraintTop_toBottomOf="@id/distance_value_text_view"
        tools:ignore="SpUsage"
        tools:text="한남오거리" />
</androidx.constraintlayout.widget.ConstraintLayout>
