    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navi_guide_ui_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" android:tag="layout/navi_guide_ui_view_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.tmapmobility.tmap.tmapsdk.ui.view.SDISpeedView
            android:id="@+id/sdi_speed_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.tmapmobility.tmap.tmapsdk.ui.view.top.NavigationTopTbt
            android:id="@+id/top_tbt"
            android:layout_width="@dimen/tmap_0dp"
            android:layout_height="@dimen/tmap_0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.tmapmobility.tmap.tmapsdk.ui.view.TBTView
            android:id="@+id/navi_mode_tbt_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="binding_1"                                                                                                  
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
                                               
                                            
                                  
                                            
                                            
                                                        />

        <com.tmapmobility.tmap.tmapsdk.ui.view.LaneView
            android:id="@+id/lane_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="binding_2"         
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
                                                      
                                                                                                                                                                              
            android:visibility="gone" />

        <com.tmapmobility.tmap.tmapsdk.ui.view.HipassLaneView
            android:id="@+id/hipass_lane_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:tag="binding_3"                   
                                                                                                                                                                              
            android:visibility="gone" />

        <com.tmapmobility.tmap.tmapsdk.ui.view.progress.NaviProgressView
            android:id="@+id/navi_progress_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:tag="binding_4"                                                             
                                                                                             
                                                                                                    />

    </androidx.constraintlayout.widget.ConstraintLayout>
         