    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navi_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="layout/navigation_bottom_info_view_0"                                                                           xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bitdraw="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navi_bottom_info_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tmap_55dp"
            android:tag="binding_1"                                                       
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/navi_bottom_left_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent">

                <ImageButton
                    android:id="@+id/navi_bottom_reroute_btn"
                    android:layout_width="@dimen/tmap_52dp"
                    android:layout_height="@dimen/tmap_54dp"
                    android:tag="binding_2"                                                                                            
                                                                
                                                                                                                                           
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                                                                                             />

                <ImageButton
                    android:id="@+id/navi_bottom_simulation_repeat_btn"
                    android:layout_width="@dimen/tmap_52dp"
                    android:layout_height="@dimen/tmap_54dp"
                    android:tag="binding_3"                                                                                            
                                                                
                                                                                                                
                                                      
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                                                                         />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageButton
                android:id="@+id/navi_bottom_stop_btn"
                android:layout_width="@dimen/tmap_52dp"
                android:layout_height="@dimen/tmap_54dp"
                android:tag="binding_4"                                                                                            
                                                            
                                                                                                                              
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                                                                                                     />

            <ImageButton
                android:id="@+id/navi_bottom_simulation_exit_btn"
                android:layout_width="@dimen/tmap_52dp"
                android:layout_height="@dimen/tmap_54dp"
                android:tag="binding_5"                                                                                            
                                                            
                                                                                                            
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                                                                                                          />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/navi_bottom_time_distance_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:tag="binding_6"                     
                                                                                                                                   
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@id/navi_bottom_vertical_left_button_guideline"
                                                                                                                                                                                                      >

                <View
                    android:id="@+id/navi_bottom_time_left_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_7"                                                          
                                                                                                                                            
                    app:layout_constrainedHeight="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/navi_bottom_time_right_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_8"                                                          
                                                                                                                                                                                                      
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/navi_bottom_distance_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/navi_bottom_time_layout">

                    <TextView
                        android:id="@+id/navi_bottom_distance_digit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:tag="binding_9"                                                     
                        android:textSize="@dimen/tmap_30dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/navi_bottom_distance_unit"
                        app:layout_constraintTop_toTopOf="parent"
                                                                            />

                    <TextView
                        android:id="@+id/navi_bottom_distance_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_1dp"
                        android:fontFamily="@font/roboto_medium"
                        android:tag="binding_10"                                                    
                        android:textSize="@dimen/tmap_20dp"
                        app:layout_constraintBaseline_toBaselineOf="@id/navi_bottom_distance_digit"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintLeft_toRightOf="@id/navi_bottom_distance_digit"
                        app:layout_constraintRight_toRightOf="parent"
                                                                                 />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/navi_bottom_time_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/navi_bottom_distance_layout"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/navi_bottom_time_am_pm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/tmap_5dp"
                        android:fontFamily="@font/skp_go_bm"
                        android:tag="binding_11"                                                    
                        android:textSize="@dimen/tmap_18dp"
                                                                                          
                                                                          
                        app:layout_constraintBottom_toBottomOf="@id/navi_bottom_arrival_time"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/navi_bottom_arrival_time" />

                    <TextView
                        android:id="@+id/navi_bottom_arrival_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_3dp"
                        android:fontFamily="@font/roboto_bold"
                        android:tag="binding_12"                                                    
                        android:textSize="@dimen/tmap_30dp"
                                                                                          
                                                                    
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintLeft_toRightOf="@id/navi_bottom_time_am_pm"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/navi_bottom_remain_time_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:tag="binding_13"                                                    
                        android:textSize="@dimen/tmap_30dp"
                                                                  
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                                                                         />

                    <TextView
                        android:id="@+id/navi_bottom_remain_time_hour_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/tmap_5dp"
                        android:fontFamily="@font/skp_go_bm"
                        android:text="@string/str_tmap_common_hour"
                        android:tag="binding_14"                                                    
                        android:textSize="@dimen/tmap_18dp"
                                                                  
                        app:layout_constraintBottom_toBottomOf="@id/navi_bottom_remain_time_hour"
                        app:layout_constraintLeft_toRightOf="@id/navi_bottom_remain_time_hour"
                                                                                         />

                    <TextView
                        android:id="@+id/navi_bottom_remain_time_minute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:tag="binding_15"                                                    
                        android:textSize="@dimen/tmap_30dp"
                                                                  
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@id/navi_bottom_remain_time_hour_unit"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginLeft="0dp"
                                                                           />

                    <TextView
                        android:id="@+id/navi_bottom_remain_time_minute_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/tmap_5dp"
                        android:fontFamily="@font/skp_go_bm"
                        android:text="@string/str_tmap_common_minute"
                        android:tag="binding_16"                                                    
                        android:textSize="@dimen/tmap_18dp"
                                                                  
                        app:layout_constraintBottom_toBottomOf="@id/navi_bottom_remain_time_minute"
                        app:layout_constraintLeft_toRightOf="@id/navi_bottom_remain_time_minute"
                                                                                           />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/navi_bottom_address_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:tag="binding_17"                                                                             
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@id/navi_bottom_vertical_center_guideline"
                app:layout_constraintRight_toLeftOf="@id/navi_bottom_vertical_right_button_guideline"
                tools:layout_editor_absoluteY="0dp">

                <ImageView
                    android:id="@+id/navi_bottom_landscape_info_image"
                    android:layout_width="@dimen/tmap_18dp"
                    android:layout_height="@dimen/tmap_18dp"
                    android:layout_marginLeft="@dimen/tmap_19dp"
                    android:tag="binding_18"                      
                                                                   
                                                      
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/navi_bottom_landscape_address_text"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/navi_bottom_landscape_address_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tmap_6dp"
                    android:layout_marginRight="@dimen/tmap_20dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/skp_go_bm"
                    android:singleLine="true"
                    android:tag="binding_19"                                                      
                    android:textSize="@dimen/tmap_16dp"
                                                            
                                                                  
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/navi_bottom_landscape_info_image"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/navi_bottom_landscape_right_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_20"                                                         
                                                                                                                                         
                    app:layout_constrainedHeight="true"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/navi_bottom_ando_exit_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:tag="binding_21"                                                      
                                                            
                                                                                                           
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                                                                                                                                                                                                      >

                <TextView
                    android:id="@+id/navi_bottom_ando_exit_text"
                    android:layout_width="@dimen/tmap_0dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_margin="@dimen/tmap_8dp"
                    android:background="@drawable/navi_blue_button_selector"
                    android:fontFamily="@font/skp_go_bm"
                    android:gravity="center"
                    android:text="@string/tmap_ando_end"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/tmap_18dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/navi_bottom_ando_exit_right_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_22"                                                         
                    app:layout_constrainedHeight="true"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/navi_bottom_via_next_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:tag="binding_23"                                                      
                                                            
                                                                               
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@id/navi_bottom_left_button"
                                                                                                                                                                                                      >

                <TextView
                    android:id="@+id/navi_bottom_via_next_text"
                    android:layout_width="@dimen/tmap_0dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_margin="@dimen/tmap_8dp"
                    android:tag="binding_24"                                                                                             
                    android:fontFamily="@font/skp_go_bm"
                    android:gravity="center"
                    android:text="@string/route_guide_to_next"
                                                                                                
                    android:textSize="@dimen/tmap_18dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/navi_bottom_via_next_left_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_25"                                                         
                    app:layout_constrainedHeight="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/navi_bottom_via_next_right_divider"
                    android:layout_width="@dimen/tmap_1dp"
                    android:layout_height="@dimen/tmap_0dp"
                    android:layout_marginTop="@dimen/tmap_1dp"
                    android:tag="binding_26"                                                         
                    app:layout_constrainedHeight="true"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/navi_bottom_top_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tmap_1dp"
                android:tag="binding_27"                                                         
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/navi_bottom_vertical_center_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/navi_bottom_vertical_left_button_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/tmap_52dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/navi_bottom_vertical_right_button_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/tmap_52dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navi_bottom_portrait_address_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tmap_31dp"
            android:tag="binding_28"                                                           
                                                                                                                 
            app:layout_constraintBottom_toTopOf="@id/navi_bottom_info_layout">

            <ImageView
                android:id="@+id/navi_bottom_portrait_info_image"
                android:layout_width="@dimen/tmap_24dp"
                android:layout_height="@dimen/tmap_24dp"
                android:layout_marginStart="@dimen/tmap_20dp"
                android:tag="binding_29"                      
                                                               
                                                  
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/navi_bottom_portrait_info_text"
                app:layout_constraintTop_toTopOf="parent" />

            <com.tmapmobility.tmap.tmapsdk.ui.view.CustomTextView
                android:id="@+id/navi_bottom_portrait_info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_1dp"
                android:layout_marginEnd="@dimen/tmap_20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:padding="@dimen/tmap_3dp"
                android:singleLine="true"
                android:tag="binding_30"                                                      
                android:textSize="@dimen/tmap_16dp"
                                                        
                                                              
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toRightOf="@id/navi_bottom_portrait_info_image"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                bitdraw:textStroke="true"
                                                                                                  
                bitdraw:textStrokeWidth="@dimen/tmap_3dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/navi_bottom_info_shadow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tmap_5dp"
            android:alpha="0.06"
            android:background="@drawable/navi_bottom_info_shadow"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/navi_bottom_portrait_address_layout" />

    </androidx.constraintlayout.widget.ConstraintLayout>
         