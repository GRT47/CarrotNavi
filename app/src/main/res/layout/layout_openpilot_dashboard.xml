<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/openpilotDashboardContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121217">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. 헤더: 연결 상태 및 기기 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/vOpDashConnDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/shape_circle_gray" />

                <TextView
                    android:id="@+id/tvOpDashConnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP 연결 대기"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvOpDashDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: - · Ver: -"
                    android:textColor="#71717A"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2. 대형 속도 & 크루즈 상태 메인 카드 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardOpDashSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_op_card"
                android:paddingVertical="18dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp">

                <!-- 계기판 상단 바 (크루즈 인게이지 배지 + 차량 상단 플로팅 신호등) -->
                <LinearLayout
                    android:id="@+id/llOpDashTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- 크루즈 인게이지 배지 (좌측) -->
                    <TextView
                        android:id="@+id/tvOpDashEngageBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="DISENGAGED"
                        android:textColor="#71717A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:background="@drawable/bg_op_pill"
                        android:paddingHorizontal="10dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- 차량 이미지 바로 위 플로팅 신호등 램프 (우측) -->
                    <LinearLayout
                        android:id="@+id/llOpDashTrafficPill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_op_pill"
                        android:paddingHorizontal="10dp">

                        <View
                            android:id="@+id/vOpDashLightRed"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shape_circle_dark" />

                        <View
                            android:id="@+id/vOpDashLightYellow"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shape_circle_dark"
                            android:layout_marginStart="5dp" />

                        <View
                            android:id="@+id/vOpDashLightGreen"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shape_circle_dark"
                            android:layout_marginStart="5dp" />

                        <TextView
                            android:id="@+id/tvOpDashTrafficText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="신호 대기"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 실시간 차량 후방 라이트 그래픽 비주얼라이저 -->
                <com.example.carrotnavi.CarRearVisualizerView
                    android:id="@+id/viewCarRearVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@+id/llOpDashTopBar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 현재 속도 표시 -->
                <LinearLayout
                    android:id="@+id/llOpDashSpeedCluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/viewCarRearVisualizer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvOpDashSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="54sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvOpDashSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="#9CA3AF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <!-- 크루즈 설정 / 제어 속도 -->
                <LinearLayout
                    android:id="@+id/llOpDashCruiseStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/llOpDashSpeedCluster"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="크루즈 설정"
                            android:textColor="#71717A"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvOpDashCruiseSet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- km/h"
                            android:textColor="#38BDF8"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#2E3348" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="실제 제어 속도"
                            android:textColor="#71717A"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvOpDashCruiseCtrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- km/h"
                            android:textColor="#A78BFA"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3. E2E 모델 주행 판단 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_op_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E2E 주행 모델"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvOpDashXStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정속 주행"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_op_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/tvOpDashXStateDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정상 순항 중"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 4. 실시간 Carrot AI 제어 판단 터미널 로그 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_op_terminal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/shape_circle_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARROT AI 제어 판단 로그"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOpDashCarrotLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="주행 데이터 수신 대기 중..."
                    android:textColor="#A7F3D0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
