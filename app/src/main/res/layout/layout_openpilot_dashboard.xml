<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/openpilotDashboardContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121217">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <!-- 1. 대형 속도 & 크루즈 상태 메인 카드 (차량 비주얼라이저 & 플로팅 신호등) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardOpDashSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_op_card"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp">

                <!-- 계기판 상단 바 (크루즈 인게이지 배지 + 차량 상단 플로팅 신호등) -->
                <LinearLayout
                    android:id="@+id/llOpDashTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- 크루즈 인게이지 배지 (좌측) -->
                    <TextView
                        android:id="@+id/tvOpDashEngageBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:text="DISENGAGED"
                        android:textColor="#71717A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:background="@drawable/bg_op_pill"
                        android:paddingHorizontal="8dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- 차량 이미지 바로 위 플로팅 신호등 램프 (우측) -->
                    <LinearLayout
                        android:id="@+id/llOpDashTrafficPill"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_op_pill"
                        android:paddingHorizontal="8dp">

                        <View
                            android:id="@+id/vOpDashLightRed"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_circle_dark" />

                        <View
                            android:id="@+id/vOpDashLightYellow"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_circle_dark"
                            android:layout_marginStart="4dp" />

                        <View
                            android:id="@+id/vOpDashLightGreen"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_circle_dark"
                            android:layout_marginStart="4dp" />

                        <TextView
                            android:id="@+id/tvOpDashTrafficText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="신호 대기"
                            android:textColor="#9CA3AF"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:layout_marginStart="5dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 실시간 차량 후방 라이트 그래픽 비주얼라이저 -->
                <com.example.carrotnavi.CarRearVisualizerView
                    android:id="@+id/viewCarRearVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/llOpDashTopBar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 속도 & 크루즈 타겟 통합 클러스터 행 (좌측 대형 속도계 / 우측 크루즈 설정 및 제어 속도) -->
                <LinearLayout
                    android:id="@+id/llOpDashSpeedCluster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/viewCarRearVisualizer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- 좌측: 대형 속도계 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="horizontal"
                        android:gravity="center|bottom">

                        <TextView
                            android:id="@+id/tvOpDashSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvOpDashSpeedUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km/h"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="3dp"
                            android:layout_marginBottom="5dp" />
                    </LinearLayout>

                    <!-- 중앙 구분선 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="#252A38"
                        android:layout_marginHorizontal="6dp" />

                    <!-- 우측: 크루즈 설정 및 실제 제어 속도 -->
                    <LinearLayout
                        android:id="@+id/llOpDashCruiseStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="설정"
                                android:textColor="#71717A"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/tvOpDashCruiseSet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- km/h"
                                android:textColor="#38BDF8"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="제어"
                                android:textColor="#71717A"
                                android:textSize="10.5sp" />

                            <TextView
                                android:id="@+id/tvOpDashCruiseCtrl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- km/h"
                                android:textColor="#A78BFA"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. E2E 모델 주행 판단 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_op_card"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E2E 모델"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvOpDashXStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정속 주행"
                    android:textColor="#34D399"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_op_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/tvOpDashXStateDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="정상 순항 중"
                    android:textColor="#9CA3AF"
                    android:textSize="11.5sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
