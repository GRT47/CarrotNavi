<?xml version='1.0' encoding='utf-8'?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상단 UI 그룹 (오버레이) -->
    <LinearLayout
        android:id="@+id/llTopUiGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:padding="4dp"
        android:gravity="end"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            
            <View
                android:id="@+id/vConnectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_circle_gray"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OP 연결 대기"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCarrotVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver: -"
            android:textColor="#EEEEEE"
            android:textSize="10sp"
            android:shadowColor="#000000"
            android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2" />
        <TextView
            android:id="@+id/tvCarrotIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP: -"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:shadowColor="#000000"
            android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2" />
    </LinearLayout>




    <LinearLayout 
        android:id="@+id/llSpeedGroup" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:orientation="horizontal" 
        android:layout_gravity="top|start" 
        android:elevation="7dp">

        <LinearLayout 
            android:id="@+id/llRoadSpeedLimit" 
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content" 
            android:orientation="vertical" 
            android:gravity="center">

            <FrameLayout 
                android:layout_width="72dp" 
                android:layout_height="72dp">
                
                <ImageView 
                    android:layout_width="match_parent" 
                    android:layout_height="match_parent" 
                    android:src="@drawable/bg_speed_limit_blue" />
                    
                <TextView 
                    android:id="@+id/tvRoadSpeedLimit" 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:layout_gravity="center" 
                    android:text="-" 
                    android:textColor="#000000" 
                    android:textSize="28sp" 
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    
    

    <LinearLayout android:id="@+id/llStatusGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="80dp" android:layout_marginEnd="16dp" android:layout_gravity="top|end" android:elevation="6dp">
        <LinearLayout android:id="@+id/llGpsInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:gravity="center_vertical" android:background="@drawable/bg_text_pill">

            <!-- [Row 1] GPS 상태 및 툴바/안내 영역 -->
            <LinearLayout
                android:id="@+id/llGpsTopRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- [구역 1] GPS 상태 뱃지 -->
                <LinearLayout
                    android:id="@+id/llGpsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_hud_gps_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">
                    <ImageView
                        android:id="@+id/ivGpsIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_satellite"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="GPS Status Icon" />
                    <TextView
                        android:id="@+id/tvGpsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS 상태"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 경로 안내 도착시간(터치 시 남은시간 전환) & 남은거리 그룹 -->
                <LinearLayout
                    android:id="@+id/llRouteEtaGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <!-- GPS 상태와 도착 정보 사이 좌측 구분선 -->
                    <View
                        android:id="@+id/vRouteEtaStartDivider"
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#44FFFFFF" />

                    <!-- 도착시간/남은시간 터치 토글 뱃지 (내용물에 맞게 wrap_content 보장되어 절대 글자 안 잘림) -->
                    <LinearLayout
                        android:id="@+id/btnToggleEtaTime"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:background="@drawable/bg_eta_time_clickable"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvEtaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="도착"
                            android:textColor="#FFD54F"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvEtaTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- 남은거리 표시 (wrap_content로 항상 온전하게 표시) -->
                    <TextView
                        android:id="@+id/tvRemainDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"
                        android:text="-- km"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <!-- 도착시간/남은거리와 경로취소 버튼 사이의 명확한 경계 구분선 -->
                    <View
                        android:id="@+id/vRouteEtaEndDivider"
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#44FFFFFF" />
                </LinearLayout>

                <!-- [구역 2] 원터치 목적지 버튼 그룹 (집, 사무실, 즐겨찾기) - 티맵 안전운행 시에만 표시 -->
                <LinearLayout
                    android:id="@+id/llQuickDestGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:visibility="gone">

                    <!-- 구역 1(GPS 상태)과 구역 2(원터치 목적지) 사이 구분선 -->
                    <View
                        android:id="@+id/vGpsQuickDivider"
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#44FFFFFF" />

                    <!-- 원터치 목적지 3개 버튼을 묶어주는 툴바 컨테이너 -->
                    <LinearLayout
                        android:id="@+id/llQuickDestToolbar"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hud_quick_group"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">

                        <LinearLayout
                            android:id="@+id/btnQuickHome"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_hud_quick_btn"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvQuickHome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏠 집"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:shadowColor="#000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="2" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnQuickOffice"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:background="@drawable/bg_hud_quick_btn"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvQuickOffice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏢 사무실"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:shadowColor="#000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="2" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnQuickFavorites"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:background="@drawable/bg_hud_quick_btn"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvQuickFavorites"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ 즐겨찾기"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:shadowColor="#000000"
                                android:shadowDx="1"
                                android:shadowDy="1"
                                android:shadowRadius="2" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 가로모드에서 Row 1과 Row 2 사이 구분선 (세로모드에서는 GONE) -->
            <View
                android:id="@+id/vGpsDivider"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#44FFFFFF"
                android:visibility="gone" />

            <!-- [Row 2 / 가로모드에서는 우측 영역] 현위치 주소 및 경로취소 영역 -->
            <LinearLayout
                android:id="@+id/llGpsBottomRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- [구역 3] 현위치 주소 칩 (위치 핀 아이콘 + 주소 텍스트 중앙 정렬) -->
                <TextView
                    android:id="@+id/tvGpsAddress"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_hud_address_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <!-- 경로 취소 버튼 (카카오 경로 안내 중에만 표시) -->
                <LinearLayout
                    android:id="@+id/btnGpsCancelRoute"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_btn_cancel_route"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_round_close_24"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="경로취소"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    
    

    
    <LinearLayout android:id="@+id/llBottomLeftOverlays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_gravity="bottom|start" android:layout_marginStart="16dp" android:layout_marginBottom="32dp" android:elevation="6dp">

        


        

    </LinearLayout>

    <!-- 플로팅 미니 미디어 정보 오버레이 카드 (재생 현황) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvMediaOverlayCard"
        android:layout_width="230dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="256dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#F21E1E1E"
        app:cardElevation="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- [가로 형태] 재생현황 컨테이너 -->
        <LinearLayout
            android:id="@+id/llMediaOverlayHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <!-- 앨범아트 썸네일 + 재생상태 뱃지 -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvMediaOverlayThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#333333">
                    <ImageView
                        android:id="@+id/ivMediaOverlayThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- 재생 상태 뱃지 (재생중/일시정지) -->
                <ImageView
                    android:id="@+id/ivMediaOverlayPlayStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_dark_translucent"
                    android:src="@drawable/ic_round_play_arrow_24"
                    app:tint="#FFEB3B"
                    android:padding="2dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 곡 제목 & 아티스트 -->
            <LinearLayout
                android:id="@+id/llMediaOverlayInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tvMediaOverlayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="재생 중인 음악 없음"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <TextView
                    android:id="@+id/tvMediaOverlayArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- [세로 형태] 재생현황 컨테이너 -->
        <LinearLayout
            android:id="@+id/llMediaOverlayVertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <!-- 세로형 앨범아트 썸네일 + 재생상태 뱃지 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvMediaOverlayThumbVert"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#333333">
                    <ImageView
                        android:id="@+id/ivMediaOverlayThumbVert"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- 세로형 재생 상태 뱃지 -->
                <ImageView
                    android:id="@+id/ivMediaOverlayPlayStatusVert"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_circle_dark_translucent"
                    android:src="@drawable/ic_round_play_arrow_24"
                    app:tint="#FFEB3B"
                    android:padding="3dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 세로형 곡 제목 & 아티스트 -->
            <LinearLayout
                android:id="@+id/llMediaOverlayInfoVert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tvMediaOverlayTitleVert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="재생 중인 음악 없음"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <TextView
                    android:id="@+id/tvMediaOverlayArtistVert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#AAAAAA"
                    android:textSize="10.5sp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginTop="2dp"
                    android:paddingBottom="2dp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 하단 재생바 (재생 현황 인디케이터) -->
        <ProgressBar
            android:id="@+id/pbMediaOverlayProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:minHeight="0dp"
            android:maxHeight="3dp"
            android:max="1000"
            android:progress="0"
            android:clickable="false"
            android:focusable="false"
            android:progressDrawable="@drawable/progress_media_overlay"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/llRightBottomGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|end"
        android:gravity="center_horizontal"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp">

        <ImageButton 
            android:id="@+id/btnMediaOverlay" 
            android:layout_width="48dp" 
            android:layout_height="48dp" 
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_music_note" 
            android:background="@drawable/shape_circle_gray" 
            android:scaleType="center" 
            android:elevation="6dp" />

        <ImageButton 
            android:id="@+id/btnSettings" 
            android:layout_width="48dp" 
            android:layout_height="48dp" 
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_preferences" 
            android:background="@drawable/shape_circle_gray" 
            android:scaleType="center" 
            android:elevation="6dp" />


        <ImageButton
            android:id="@+id/btnSearchAddress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- 실시간 나침반 / 차량 진행 방위각 (nPosAngle) 뱃지 (좌측 상단 표지판 아래) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvCompassOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="78dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#D90E131F"
        app:cardElevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivCompassNeedle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_compass_needle"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCompassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° N"
                android:textColor="#00F2FE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 상단 중앙 HUD 그룹 (스마트 신호등 + 차선 가이드) -->
    <LinearLayout
        android:id="@+id/llTopCenterContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:elevation="10dp">

        <!-- C-ITS 스마트 교통 신호등 오버레이 (ObservableTrafficSignalData) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvTrafficSignalOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#EA0A0D14"
            app:cardElevation="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <!-- 4구 신호등 하우징 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#202530"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="10dp">

                    <!-- 적색 -->
                    <View
                        android:id="@+id/vSignalRed"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/shape_circle_red"
                        android:layout_marginEnd="5dp" />

                    <!-- 황색 -->
                    <View
                        android:id="@+id/vSignalYellow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/shape_circle_dark"
                        android:layout_marginEnd="5dp" />

                    <!-- 좌회전 -->
                    <ImageView
                        android:id="@+id/ivSignalLeft"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_signal_left"
                        android:alpha="0.2"
                        android:layout_marginEnd="5dp" />

                    <!-- 녹색 -->
                    <View
                        android:id="@+id/vSignalGreen"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/shape_circle_dark" />
                </LinearLayout>

                <!-- 전방 신호등 거리 -->
                <TextView
                    android:id="@+id/tvSignalDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150m"
                    android:textColor="#A0AEC0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />

                <!-- 신호 잔여 시간 카운트다운 -->
                <TextView
                    android:id="@+id/tvSignalRemainTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15s"
                    android:textColor="#FF3B30"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 전방 교차로 차선 가이드 오버레이 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvLaneGuideOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#D90E131F"
            app:cardElevation="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:gravity="center_horizontal">

                <!-- 상단: 교차로 남은 거리 뱃지 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    
                    <TextView
                        android:id="@+id/tvLaneGuideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전방 교차로"
                        android:textColor="#A0AEC0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvLaneGuideDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="300m"
                        android:textColor="#00F2FE"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 하단: 가로 방향 차선 목록 컨테이너 -->
                <LinearLayout
                    android:id="@+id/llLaneContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</merge>