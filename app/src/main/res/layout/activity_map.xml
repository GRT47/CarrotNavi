<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#222222">

    <!-- 상단 통합 UI 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#222222">

        <!-- 연결 상태 (왼쪽) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_sdi_panel"
            android:padding="12dp">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <View
                    android:id="@+id/vConnectionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_circle_gray"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OP 연결 대기"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvCarrotVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver: -"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/tvCarrotIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -"
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 버튼 그룹 (오른쪽) -->
        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v-"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditKey"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="설정"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnExitApp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="앱 종료"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:backgroundTint="#F44336" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 지도 영역 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        
        <FrameLayout
            android:id="@+id/tmapUILayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 1. 속도 정보 그룹 (도로 제한속도 + 과속단속) -->
        <LinearLayout
            android:id="@+id/llSpeedGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_sdi_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:elevation="6dp">

            <!-- 1-1. 현재 도로 제한속도 오버레이 -->
            <LinearLayout
                android:id="@+id/llRoadSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- 헤더: 제한속도 텍스트를 위로 올림 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제한속도"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- 속도 제한 표지판 그래픽 (블루 서클 디자인) - 72dp -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="6dp">
                    
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_speed_limit_blue" />
                        
                    <TextView
                        android:id="@+id/tvRoadSpeedLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="-"
                        android:textColor="#000000"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 바닥 높이 맞추기용 빈 공간 (tvEventDist의 크기인 16sp와 매칭) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 간격 -->
            <View
                android:layout_width="8dp"
                android:layout_height="0dp"/>

            <!-- 1-2. 과속 카메라 (SDI 이벤트) 오버레이 -->
            <LinearLayout
                android:id="@+id/llSdiEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- 헤더: 카메라 아이콘과 타입 명칭 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    
                    <ImageView
                        android:id="@+id/ivCameraIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_camera"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Camera Icon"/>
                        
                    <TextView
                        android:id="@+id/tvEventType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="단속구간"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 카메라 속도 제한 표지판 - 72dp (크기 일치) -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="6dp">
                    
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_speed_limit" />
                        
                    <TextView
                        android:id="@+id/tvEventSpeedLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="60"
                        android:textColor="#000000"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 바닥: 남은 거리 -->
                <TextView
                    android:id="@+id/tvEventDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300m"
                    android:textColor="#FFEB3B"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 상태 정보 그룹 (GPS 상태 + 오픈파일럿) -->
        <LinearLayout
            android:id="@+id/llStatusGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="170dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_sdi_panel"
            android:elevation="6dp">

            <!-- 2-1. GPS 상태 오버레이 -->
            <LinearLayout
                android:id="@+id/llGpsInfo"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivGpsIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_satellite"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="GPS Status Icon"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS 상태"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="확인"
                    android:textColor="#FFEB3B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 수직 구분선 -->
            <View
                android:layout_width="1dp"
                android:layout_height="70dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"/>

            <!-- 2-2. Openpilot 상태 오버레이 -->
            <LinearLayout
                android:id="@+id/llOpInfo"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivOpIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_steering_wheel"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="Openpilot Icon"/>

                <TextView
                    android:id="@+id/tvActiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/vTrafficLight"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_circle_gray"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/tvXStateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRUISE"
                        android:textColor="#2196F3"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- 지도 터치 방지용 투명 오버레이 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- 5. 여유 가속 조절 오버레이 -->
        <LinearLayout
            android:id="@+id/llOffset"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sdi_panel"
            android:padding="12dp"
            android:gravity="center"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivSpeedometerIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_speedometer"
                android:layout_marginBottom="6dp"
                android:contentDescription="Speedometer Icon"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">
                <TextView
                    android:id="@+id/tvOffsetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여유가속"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/btnOffsetInfo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/shape_circle_gray" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|bottom"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/tvOffsetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                
                <Button
                    android:id="@+id/btnDecreaseOffset"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="-"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:backgroundTint="#555555"/>
                    
                <Button
                    android:id="@+id/btnIncreaseOffset"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="+"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:backgroundTint="#555555"/>
            </LinearLayout>

            <!-- 구간단속 정보 -->
            <LinearLayout
                android:id="@+id/llBlockInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="gone">
                
                <TextView
                    android:id="@+id/tvBlockAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="평균 0km/h"
                    android:textColor="#FFEB3B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/tvBlockDistTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="남은 0m"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 좌측 하단 고정 오버레이 (TBT 설정, 디버그) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="32dp"
            android:elevation="6dp">

            <!-- TBT TurnType Override 오버레이 -->
            <LinearLayout
                android:id="@+id/llTurnTypeOverride"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_sdi_panel"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TBT설정:"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvTurnTypeOverride"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자동"
                    android:textColor="#FF9800"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 디버그 오버레이 -->
            <LinearLayout
                android:id="@+id/llDebugOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_sdi_panel"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="디버그"
                    android:textColor="#03A9F4"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오버레이 기본값 복원 버튼 -->
        <ImageButton
            android:id="@+id/btnRestoreDefaults"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="92dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- 오버레이 표시/숨기기 버튼 -->
        <ImageButton
            android:id="@+id/btnToggleVisibility"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="76dp"
            android:layout_marginBottom="32dp"
            android:src="@android:drawable/ic_menu_view"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp" />

        <!-- 오버레이 편집 모드 버튼 (그래픽) -->
        <ImageButton
            android:id="@+id/btnEditMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="@drawable/shape_circle_gray"
            android:scaleType="center"
            android:elevation="6dp" />
    </FrameLayout>

</LinearLayout>
