<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CarrotNavi Debug Sender"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: "
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/etIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="255.255.255.255"
                android:textColor="#FFFFFF"
                android:inputType="textUri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Port: "
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/etPort"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="7706"
                android:textColor="#FFFFFF"
                android:inputType="number" />
        </LinearLayout>

        <!-- Fields Container -->
        <LinearLayout
            android:id="@+id/llFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom JSON Preview"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etJsonPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top|start"
            android:background="#222222"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:padding="8dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btnGenerateJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JSON 생성"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSendUdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UDP 전송"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
