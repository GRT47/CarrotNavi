<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="CommaNav 설정"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 내비게이션 실행 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내비게이션 실행"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartNavi"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="내비게이션 실행"
                        app:backgroundTint="#FF5252"
                        android:textSize="16sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 주행 설정 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주행 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <Switch
                        android:id="@+id/cbDistanceFormatKm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1000m 이상일 때 km 단위로 표시"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnDebugPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="디버그 페이지로 이동"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="구간단속 보상가속 여유 속도"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderOffset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="50"
                            android:stepSize="1"/>
                            
                        <TextView
                            android:id="@+id/tvOffsetValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0 km/h"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- 보상가속 모드 설정 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보상가속 모드 설정"
                        android:textColor="#DDDDDD"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <RadioGroup
                        android:id="@+id/rgBoostMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/rbBoostProgressive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="점진적 보상가속 (기본: 목표속도 도달 시 중단)"/>
                        <RadioButton
                            android:id="@+id/rbBoostFixed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="고정 보상가속 (강제 유지)"/>
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="목표 평균속도 하향값 (km/h)"
                        android:textColor="#DDDDDD"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFakeDrop"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="20"
                            android:stepSize="1"/>
                            
                        <TextView
                            android:id="@+id/tvFakeDropValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 권한 및 시스템 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="권한 및 시스템"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <Switch
                        
                        
                        
                        android:id="@+id/cbBackgroundLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="항상 허용 (백그라운드 동작)"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OP 연결 상태:"
                            android:textColor="#DDDDDD"/>
                        <TextView
                            android:id="@+id/tvOpStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="대기중"
                            android:textColor="#AAAAAA"
                            android:layout_marginStart="8dp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tmap API 키 설정 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tmap API 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tmap App Key"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#AAAAAA"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAppKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kakao API 키 설정 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kakao API 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Kakao Native App Key"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:hintTextColor="#AAAAAA"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKakaoNativeAppKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Kakao REST API Key"
                        app:hintTextColor="#AAAAAA"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKakaoRestApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 네트워크 및 API 키 진단 테스트 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="연결 및 API 키 진단 테스트"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 네트워크 통신 상태와 입력된 API 키의 유효성을 실시간으로 점검합니다."
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="14dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="네트워크 및 API 키 연결 테스트"
                        app:backgroundTint="#0288D1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"/>

                    <!-- 진행 상태 표시 바 -->
                    <LinearLayout
                        android:id="@+id/llTestProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvTestProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="네트워크 및 API 인증 점검 중..."
                            android:textColor="#00E5FF"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- 진단 결과 패널 -->
                    <LinearLayout
                        android:id="@+id/llTestResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <!-- 1. 네트워크 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌐 인터넷 네트워크"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDiagNetworkBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="대기중"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiagNetworkDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="확인 대기"
                            android:textColor="#B0BEC5"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#2C2C2C"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"/>

                        <!-- 2. Tmap App Key -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🗺️ Tmap SDK (안전운행)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDiagTmapBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="대기중"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiagTmapDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="확인 대기"
                            android:textColor="#B0BEC5"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#2C2C2C"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"/>

                        <!-- 3. Kakao Native Key -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🚗 Kakao 내비 SDK (경로안내)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDiagKakaoNativeBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="대기중"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiagKakaoNativeDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="확인 대기"
                            android:textColor="#B0BEC5"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#2C2C2C"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"/>

                        <!-- 4. Kakao REST Key -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🔍 Kakao REST API (목적지 검색)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDiagKakaoRestBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="대기중"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiagKakaoRestDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="확인 대기"
                            android:textColor="#B0BEC5"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <!-- 시스템 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 최신버전 업데이트 확인 (GitHub)"
                        app:backgroundTint="#2196F3"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdateServer"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 최신버전 업데이트 확인 (SERVER)"
                        app:backgroundTint="#00BCD4"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitApp"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 완전 종료"
                        app:backgroundTint="#F44336"
                        android:textSize="16sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 앱 정보 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">
                
                <TextView
                    android:id="@+id/tvWebServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원격 접속 서버 대기중..."
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="버전 정보 확인 중"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
