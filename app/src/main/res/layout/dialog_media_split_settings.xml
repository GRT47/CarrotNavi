<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 헤더 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎵 미디어 화면 분할 설정"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <ImageView
                    android:id="@+id/btnCloseMediaSettings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_round_close_24"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#AAAAAA"/>
            </LinearLayout>

            <!-- 화면 분할 비율 섹션 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내비 지도 화면 비율"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 퀵 비율 프리셋 버튼 그리드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnRatioHalf"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="1:1"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnRatioDefault"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="7:3 (기본)"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnRatioMini"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="4:1 (미니)"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnRatioFullScreen"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="전체화면"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333333"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMediaRatio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="0.5"
                    android:valueFrom="0.5"
                    android:valueTo="5.0"
                    android:value="3.5"/>

                <TextView
                    android:id="@+id/tvMediaRatioValue"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="3.5 : 1.5"
                    android:textColor="#FFEB3B"
                    android:gravity="end"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginBottom="16dp"/>

            <!-- 미디어 뒷배경 스타일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="미디어 배경 스타일"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgMediaBgStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbBgAlbumArt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="앨범아트"
                    android:textColor="#FFFFFF"/>

                <RadioButton
                    android:id="@+id/rbBgEq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQ 시각화 (막대)"
                    android:textColor="#FFFFFF"/>

                <RadioButton
                    android:id="@+id/rbBgEqWave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQ 시각화 (물결)"
                    android:textColor="#FFFFFF"/>

                <RadioButton
                    android:id="@+id/rbBgEqCircle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EQ 시각화 (원형)"
                    android:textColor="#FFFFFF"/>
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbShowAlbumArtWithEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EQ 사용 시 앨범아트도 흐리게 표시"
                android:textColor="#DDDDDD"
                android:layout_marginBottom="16dp"/>

            <!-- 완료 버튼 -->
            <Button
                android:id="@+id/btnConfirmMediaSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="완료"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="#FFEB3B"/>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
