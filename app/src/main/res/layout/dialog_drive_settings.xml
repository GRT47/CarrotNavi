<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="상세 설정"
            app:titleTextColor="#FFFFFF">

            <ImageView
                android:id="@+id/btnCloseSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="닫기" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 주행 설정 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주행 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>



                    <Switch
                        android:id="@+id/cbDistanceFormatKm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1000m 이상일 때 km 단위로 표시"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnDebugPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="디버그 페이지로 이동"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <Switch
                        android:id="@+id/swBoostEnable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="구간단속 보상가속 기능 켜기"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/llBoostSettingsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="구간단속 보상가속 여유 속도"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderOffset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="50"
                            android:stepSize="1"/>
                            
                        <TextView
                            android:id="@+id/tvOffsetValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0 km/h"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- 보상가속 모드 설정 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보상가속 모드 설정"
                        android:textColor="#DDDDDD"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <RadioGroup
                        android:id="@+id/rgBoostMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/rbBoostProgressive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="점진적 보상가속 (기본: 목표속도 도달 시 중단)"/>
                        <RadioButton
                            android:id="@+id/rbBoostFixed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="고정 보상가속 (강제 유지)"/>
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="목표 평균속도 하향값 (km/h)"
                        android:textColor="#DDDDDD"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFakeDrop"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="20"
                            android:stepSize="1"/>
                            
                        <TextView
                            android:id="@+id/tvFakeDropValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 오디오 설정 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오디오 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="안내 시 다른 미디어 처리 방식"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>
                        
                    <RadioGroup
                        android:id="@+id/rgAudioDuckingMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <RadioButton
                            android:id="@+id/rbAudioDuckingNone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="사용 안함 (기본)"/>
                        <RadioButton
                            android:id="@+id/rbAudioDuckingVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="볼륨 줄이기 (오디오 포커스)"/>
                        <RadioButton
                            android:id="@+id/rbAudioDuckingPause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:text="강제 일시정지 후 재생 (샤오미 등)"/>
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내비게이션 안내 음량"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderVoiceVolume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0.0"
                            android:valueTo="1.0"
                            android:stepSize="0.1"
                            android:value="1.0"/>
                            
                        <TextView
                            android:id="@+id/tvVoiceVolumeValue"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 권한 및 시스템 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="권한 및 시스템"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <Switch
                        android:id="@+id/cbBackgroundLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="항상 허용 (백그라운드 동작)"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMediaPermission"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="미디어 권한 허용 (필수)"
                        app:backgroundTint="#FF9800"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OP 연결 상태:"
                            android:textColor="#DDDDDD"/>
                        <TextView
                            android:id="@+id/tvOpStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="대기중"
                            android:textColor="#AAAAAA"
                            android:layout_marginStart="8dp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- 미디어 및 화면 분할 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="미디어 화면 분할 설정"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="미디어 뒷배경 스타일"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgMediaBgStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        
                        <RadioButton
                            android:id="@+id/rbBgAlbumArt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="앨범아트"
                            android:textColor="#FFFFFF"/>
                            
                        <RadioButton
                            android:id="@+id/rbBgEq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EQ 시각화 (막대)"
                            android:textColor="#FFFFFF"/>
                            
                        <RadioButton
                            android:id="@+id/rbBgEqWave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EQ 시각화 (물결)"
                            android:textColor="#FFFFFF"/>
                            
                        <RadioButton
                            android:id="@+id/rbBgEqCircle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EQ 시각화 (원형)"
                            android:textColor="#FFFFFF"/>
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/cbShowAlbumArtWithEq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EQ 사용 시 앨범아트도 흐리게 표시"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내비 지도 화면 비율 (기본 5:1)"
                        android:textColor="#DDDDDD"
                        android:layout_marginBottom="8dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderMediaRatio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="0.5"
                            android:valueFrom="0.5"
                            android:valueTo="5.0"
                            android:value="5.0"/>
                            
                        <TextView
                            android:id="@+id/tvMediaRatioValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="5 : 1"
                            android:textColor="#FFFFFF"
                            android:gravity="end"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 시스템 섹션 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="API 키 수정 (초기 설정으로 이동)"
                        app:backgroundTint="#4CAF50"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 최신버전 업데이트 확인 (GitHub)"
                        app:backgroundTint="#2196F3"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdateServer"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 최신버전 업데이트 확인 (SERVER)"
                        app:backgroundTint="#00BCD4"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitApp"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="앱 완전 종료"
                        app:backgroundTint="#F44336"
                        android:textSize="16sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 앱 정보 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">
                
                <TextView
                    android:id="@+id/tvWebServerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원격 접속 서버 대기중..."
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="버전 정보 확인 중"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


