<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:layout="http://schemas.android.com/tools"
    android:background="@color/blue_gray_900"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/highway_info_night_border"
        android:layout_width="@dimen/size_0_5"
        android:layout_height="@dimen/size_0"
        android:background="@color/black"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

    </View>

    <View
        android:id="@+id/highway_info_bg"
        android:layout_width="@dimen/size_160"
        android:layout_height="0dp"
        android:background="@color/black_88"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@+id/highway_info_night_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

    </View>

    <include
        layout="@layout/view_highway_info_top"
        android:id="@+id/highway_info_top"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        app:layout_constraintVertical_weight="0.295"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/highway_info_mid">

    </include>

    <include
        layout="@layout/view_highway_info_mid"
        android:id="@+id/highway_info_mid"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        android:layout_marginTop="@dimen/size_0_5"
        app:layout_goneMarginTop="@dimen/size_0"
        app:layout_constraintVertical_weight="0.3"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toBottomOf="@id/highway_info_top"
        app:layout_constraintBottom_toTopOf="@id/highway_info_bottom">

    </include>

    <include
        layout="@layout/view_highway_info_bottom"
        android:id="@+id/highway_info_bottom"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        android:layout_marginTop="@dimen/size_0_5"
        app:layout_goneMarginTop="@dimen/size_0"
        app:layout_constraintVertical_weight="0.4"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toBottomOf="@id/highway_info_mid"
        app:layout_constraintBottom_toTopOf="@id/highway_info_top_gap">

    </include>

    <View
        android:id="@+id/highway_info_top_gap"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        android:background="@color/blue_gray_900"
        android:importantForAccessibility="no"
        app:layout_constraintVertical_weight="0.295"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toBottomOf="@id/highway_info_bottom"
        app:layout_constraintBottom_toTopOf="@id/highway_info_mid_gap">

    </View>

    <View
        android:id="@+id/highway_info_mid_gap"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        android:background="@color/blue_gray_900"
        android:importantForAccessibility="no"
        app:layout_constraintVertical_weight="0.3"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toBottomOf="@id/highway_info_top_gap"
        app:layout_constraintBottom_toTopOf="@id/highway_info_guide">

    </View>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/highway_info_guide"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_0"
        android:gravity="center"
        android:layout_marginTop="@dimen/size_0_5"
        android:background="@color/blue_gray_900"
        android:text="@string/highway_info_guide"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.White40.Size14"
        app:layout_constraintVertical_weight="0.295"
        app:layout_constraintStart_toStartOf="@id/highway_info_bg"
        app:layout_constraintTop_toBottomOf="@id/highway_info_mid_gap"
        app:layout_constraintBottom_toBottomOf="parent">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

</androidx.constraintlayout.widget.ConstraintLayout>