<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <shape>
            <solid android:color="@color/color_55595d"/>
        </shape>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <shape>
            <solid android:color="@color/color_19000000"/>
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <shape>
            <solid android:color="@color/primary_dark_700"/>
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <shape>
            <solid android:color="@color/primary_dark_800"/>
        </shape>
    </item>
</selector>