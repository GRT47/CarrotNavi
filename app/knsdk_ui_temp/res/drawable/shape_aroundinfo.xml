<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_33000000"/>
            <corners android:bottomLeftRadius="@dimen/size_4" />
        </shape>
    </item>

    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="@dimen/size_1">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_ffffff"/>
            <stroke android:color="@color/color_40000000"
                android:width="@dimen/size_0_5"/>
        </shape>
    </item>
</layer-list>