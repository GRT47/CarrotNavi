<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<!--    <item android:state_selected="false">-->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_500"/>
            <stroke android:width="@dimen/size_1" android:color="@color/primary_500"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>

    <item android:state_pressed="true" >
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_500"/>
            <stroke android:width="@dimen/size_1" android:color="@color/primary_500"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>

    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/blue_gray_150"/>
            <stroke android:width="@dimen/size_1" android:color="@color/blue_gray_150"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>

</selector>