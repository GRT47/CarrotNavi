<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/route_option_adapter_select_background"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_60_5"
    android:background="#F9F9F9">

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/route_option_adapter_select_title"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_0"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/size_25"
        android:paddingEnd="@dimen/size_50"
        android:singleLine="true"
        android:textColor="@drawable/selector_route_option_item_text"
        android:textSize="@dimen/size_16"
        android:text="추천"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/route_option_adapter_select_bottom_line" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/route_option_adapter_select_check_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_21"
        android:layout_marginStart="@dimen/size_10"
        android:src="@drawable/ic_check"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/route_option_adapter_select_bottom_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_5"
        android:layout_marginLeft="@dimen/size_0_5"
        android:layout_marginRight="@dimen/size_0_5"
        android:background="@color/gray_200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/route_option_adapter_select_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
