<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_60_5">

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/route_category_select_title"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_60"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/size_25"
        android:paddingEnd="@dimen/size_50"
        android:singleLine="true"
        android:textColor="@color/blue_gray_950"
        android:textSize="@dimen/size_16"
        android:text="추천"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/route_category_select_bottom_line" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/route_category_select_check_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_60"
        android:layout_marginEnd="@dimen/size_21"
        android:layout_marginStart="@dimen/size_10"
        android:src="@drawable/ic_arrow_down"
        app:layout_constraintTop_toTopOf="@+id/route_category_select_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/route_category_select_title" />

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/route_category_select_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_0"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/size_25"
        android:paddingEnd="@dimen/size_50"
        android:singleLine="true"
        android:textColor="@color/primary_500"
        android:textSize="@dimen/size_16"
        android:text="내비추천"
        app:layout_constraintLeft_toRightOf="@+id/route_category_select_check_btn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/route_category_select_bottom_line" />

    <View
        android:id="@+id/route_category_select_bottom_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0_5"
        android:layout_marginLeft="@dimen/size_0_5"
        android:layout_marginRight="@dimen/size_0_5"
        android:background="@color/gray_200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/route_category_select_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/route_category_select_bottom_line" />

</androidx.constraintlayout.widget.ConstraintLayout>
