<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drive_setting_constraint_layout"
        android:layout_width="@dimen/size_300"
        android:layout_height="@dimen/size_224"
        android:layout_gravity="center" >

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/drive_setting_device_volume_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_20"
            android:gravity="center_vertical|left"
            android:text="@string/drive_device_volume"
            android:textColor="#000000"
            android:textSize="@dimen/size_16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/drive_setting_volume_title"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_device_volume_zone_divider">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/drive_setting_device_volume_seek_bar"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_32"
            android:layout_marginStart="@dimen/size_7"
            android:layout_marginEnd="@dimen/size_7"
            android:paddingStart="@dimen/size_13"
            android:paddingEnd="@dimen/size_13"
            android:thumbOffset="@dimen/size_13"
            android:thumb="@drawable/shape_seekbar_thumb"
            android:progressDrawable="@drawable/selector_seekbar_progress"
            android:max="15"
            android:progress="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/drive_setting_device_volume_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/drive_setting_device_volume_zone_divider"/>

        <View
            android:id="@+id/drive_setting_device_volume_zone_divider"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0_5"
            android:background="@color/blue_gray_200"
            android:layout_marginTop="@dimen/size_55_5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        </View>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/drive_setting_volume_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_20"
            android:gravity="center_vertical"
            android:text="@string/drive_sound_volume"
            android:textColor="#000000"
            android:textSize="@dimen/size_16"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_device_volume_zone_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_volume_zone_divider">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/drive_setting_volume_seek_bar"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_32"
            android:layout_marginStart="@dimen/size_7"
            android:layout_marginEnd="@dimen/size_7"
            android:paddingStart="@dimen/size_13"
            android:paddingEnd="@dimen/size_13"
            android:thumbOffset="@dimen/size_13"
            android:thumb="@drawable/shape_seekbar_thumb"
            android:progressDrawable="@drawable/selector_seekbar_progress"
            android:max="10"
            android:progress="10"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_device_volume_zone_divider"
            app:layout_constraintStart_toEndOf="@id/drive_setting_volume_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_volume_zone_divider"/>

        <View
            android:id="@+id/drive_setting_volume_zone_divider"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0_5"
            android:background="@color/blue_gray_200"
            android:layout_marginTop="@dimen/size_55_5"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_device_volume_zone_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        </View>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/drive_setting_darkmode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_20"
            android:text="@string/drive_option_nightmode"
            android:textColor="@color/black"
            android:textSize="@dimen/size_16"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_volume_zone_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_darkmode_zone_divider">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/drive_setting_darkmode_onoff"
            android:layout_width="@dimen/size_46"
            android:layout_height="@dimen/size_24"
            android:layout_marginEnd="@dimen/size_20"
            android:theme="@style/SwitchCommon"
            android:padding="@dimen/size_0"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_volume_zone_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_darkmode_zone_divider"
            tools:checked="false">

        </androidx.appcompat.widget.SwitchCompat>

        <View
            android:id="@+id/drive_setting_darkmode_click_layer"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_volume_zone_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drive_setting_darkmode_zone_divider"
            />

        <View
            android:id="@+id/drive_setting_darkmode_zone_divider"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0_5"
            android:background="@color/blue_gray_200"
            android:layout_marginTop="@dimen/size_55_5"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_volume_zone_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        </View>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/drive_setting_btn_close"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_56"
            android:background="@drawable/shape_drive_popup_close_btn_bg"
            android:text="@string/drive_label_close"
            android:gravity="center"
            android:textSize="@dimen/size_16"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/drive_setting_darkmode_zone_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>