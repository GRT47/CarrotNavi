<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_0_5"
    android:paddingTop="@dimen/size_0_5"
    android:paddingEnd="@dimen/size_0_5"
    android:paddingBottom="@dimen/size_1_5"
    android:background="@drawable/shape_aroundinfo"
    android:importantForAccessibility="no"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/popup_info_food_icon"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/size_16"
        android:layout_marginTop="@dimen/size_20"
        android:src="@drawable/ic_popup_food"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatImageView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_food_title"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginEnd="@dimen/size_16"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoBold.Black.Size18"
        app:layout_constraintStart_toEndOf="@id/popup_info_food_icon"
        app:layout_constraintTop_toTopOf="@id/popup_info_food_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/popup_info_food_icon">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_food_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoBold.Red.Size19"
        app:layout_constraintStart_toStartOf="@id/popup_info_food_title"
        app:layout_constraintTop_toBottomOf="@id/popup_info_food_title">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_food_address"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_5"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.Gray500.Size13"
        app:layout_constraintStart_toStartOf="@id/popup_info_food_title"
        app:layout_constraintTop_toBottomOf="@id/popup_info_food_dist"
        app:layout_constraintEnd_toEndOf="@id/popup_info_food_title">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_food_tel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.Gray800.Size15"
        app:layout_constraintStart_toStartOf="@id/popup_info_food_title"
        app:layout_constraintTop_toBottomOf="@id/popup_info_food_address">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_info_food_btn_constraint_layout"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:background="@color/gray_250"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_food_btn_add_via"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_marginTop="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_goal"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            style="@style/NaviNotoRegular.Gray900.Size18"
            app:layout_constraintHorizontal_weight="0.61"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/popup_info_food_btn_close"
            app:layout_constraintBottom_toBottomOf="parent">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_food_btn_close"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_marginStart="@dimen/size_0_5"
            android:layout_marginTop="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_close"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            style="@style/NaviNotoRegular.Gray900.Size18"
            app:layout_constraintHorizontal_weight="0.39"
            app:layout_constraintStart_toEndOf="@id/popup_info_food_btn_add_via"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>