<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_0_5"
    android:paddingTop="@dimen/size_0_5"
    android:paddingEnd="@dimen/size_0_5"
    android:paddingBottom="@dimen/size_1_5"
    android:importantForAccessibility="no"
    android:background="@drawable/shape_aroundinfo"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/yugo_info_icon"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/size_16"
        android:layout_marginTop="@dimen/size_20"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatImageView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/yugo_info_title"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginEnd="@dimen/size_16"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoBold.Black.Size18"
        app:layout_constraintStart_toEndOf="@id/yugo_info_icon"
        app:layout_constraintTop_toTopOf="@id/yugo_info_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/yugo_info_icon">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/yugo_info_description"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:maxLines="2"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.Gray500.Size15"
        app:layout_constraintStart_toStartOf="@id/yugo_info_title"
        app:layout_constraintTop_toBottomOf="@id/yugo_info_title"
        app:layout_constraintEnd_toEndOf="@id/yugo_info_title">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/yugo_info_start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoRegular.Gray500.Size13"
        app:layout_constraintStart_toStartOf="@id/yugo_info_title"
        app:layout_constraintTop_toBottomOf="@id/yugo_info_description">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/yugo_info_end_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_3"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoRegular.Gray500.Size13"
        app:layout_constraintStart_toStartOf="@id/yugo_info_start_time"
        app:layout_constraintTop_toBottomOf="@id/yugo_info_start_time">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/yugo_info_powered_by_logo"
        android:layout_width="@dimen/size_50"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_4"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toEndOf="@id/yugo_info_end_time"
        app:layout_constraintTop_toTopOf="@id/yugo_info_end_time"
        app:layout_constraintBottom_toBottomOf="@id/yugo_info_end_time">

    </androidx.appcompat.widget.AppCompatImageView>

    <View
        android:id="@+id/popup_info_yugo_talkback_layout"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_0"
        android:focusable="true"
        android:accessibilityTraversalBefore="@+id/yugo_info_btn_constraint_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/yugo_info_btn_constraint_layout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/yugo_info_btn_constraint_layout"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:background="@color/gray_250"
        android:focusable="true"
        android:contentDescription="확인"
        android:accessibilityTraversalAfter="@id/popup_info_yugo_talkback_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/yugo_info_btn_close"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_marginTop="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_ok"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            style="@style/NaviNotoRegular.Cool.Size18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        </com.kakaomobility.knsdk.ui.view.KNTextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>