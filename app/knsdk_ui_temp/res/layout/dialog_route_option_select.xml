<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:importantForAccessibility="no"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_route_option_select_constraint_layout"
        android:layout_width="@dimen/size_300"
        android:layout_height="@dimen/size_280"
        android:importantForAccessibility="no"
        android:layout_gravity="center" >

        <RelativeLayout
            android:id="@+id/dialog_route_option_select_title_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_114"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/route_category_select_top_line" >

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:id="@+id/dialog_route_option_select_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_drive_popup_close_btn_bg"
                android:gravity="left|center_vertical"
                android:layout_marginTop="@dimen/size_20"
                android:paddingStart="@dimen/size_25"
                android:text="@string/route_option_select_option"
                android:importantForAccessibility="no"
                android:textColor="@color/blue_gray_950"
                android:textSize="@dimen/size_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/dialog_route_option_select_avoid_option"/>

            <HorizontalScrollView
                android:id="@+id/dialog_route_option_select_avoid_option"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:layout_below="@+id/dialog_route_option_select_title"
                android:layout_marginTop="@dimen/size_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:importantForAccessibility="no"
                    android:paddingLeft="@dimen/size_25"
                    android:paddingRight="@dimen/size_25">

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_free"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="무료도로"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_bike"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginLeft="@dimen/size_8"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="자동차전용제외"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_school"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginLeft="@dimen/size_8"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="어린이안심"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_event"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginLeft="@dimen/size_8"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="유고무시"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_ferry"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginLeft="@dimen/size_8"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="페리제외"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/dialog_route_option_select_avoid_option_uturn"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_36"
                        android:layout_marginLeft="@dimen/size_8"
                        android:importantForAccessibility="no"
                        android:background="@drawable/selector_route_dialog_avoid_option"
                        android:clickable="true">

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingLeft="@dimen/size_10"
                            android:paddingTop="@dimen/size_8"
                            android:paddingRight="@dimen/size_10"
                            android:paddingBottom="@dimen/size_8"
                            android:text="유턴제외"
                            android:importantForAccessibility="no"
                            android:textColor="@color/selector_route_dialog_avoid_option_text"
                            android:textSize="@dimen/size_14" />
                    </RelativeLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </RelativeLayout>

        <View
            android:id="@+id/route_category_select_top_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_5"
            android:layout_marginLeft="@dimen/size_0_5"
            android:layout_marginRight="@dimen/size_0_5"
            android:background="@color/gray_200"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_route_option_select_title_layout"
            app:layout_constraintBottom_toTopOf="@+id/dialog_route_option_select_option_list"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialog_route_option_select_option_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/neutral_32"
            android:scrollbarSize="@dimen/size_4"
            android:scrollbarFadeDuration="0"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_route_option_select_title_layout"
            app:layout_constraintBottom_toTopOf="@+id/route_category_select_bottom_line"
            tools:listitem="@layout/item_option_select" />

        <View
            android:id="@+id/route_category_select_bottom_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0_5"
            android:layout_marginLeft="@dimen/size_0_5"
            android:layout_marginRight="@dimen/size_0_5"
            android:background="@color/gray_200"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_route_option_select_option_list"
            app:layout_constraintBottom_toTopOf="@+id/dialog_route_option_select_close_btn"/>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/dialog_route_option_select_cancel_btn"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_56"
            android:text="@string/route_option_select_cancel"
            android:textSize="@dimen/size_17"
            android:textColor="@color/black"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:background="@drawable/shape_drive_popup_close_btn_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/route_category_select_btn_line"
            app:layout_constraintTop_toBottomOf="@+id/route_category_select_bottom_line"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/route_category_select_btn_line"
            android:layout_width="@dimen/size_0_5"
            android:layout_height="@dimen/size_0"
            android:background="@color/gray_200"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toEndOf="@+id/dialog_route_option_select_cancel_btn"
            app:layout_constraintEnd_toStartOf="@+id/dialog_route_option_select_close_btn"
            app:layout_constraintTop_toBottomOf="@+id/route_category_select_bottom_line"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/dialog_route_option_select_close_btn"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_56"
            android:text="@string/route_option_select_close"
            android:textSize="@dimen/size_17"
            android:textColor="@color/primary_500"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:background="@drawable/shape_drive_popup_close_btn_bg"
            app:layout_constraintStart_toEndOf="@+id/route_category_select_btn_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/route_category_select_bottom_line"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>