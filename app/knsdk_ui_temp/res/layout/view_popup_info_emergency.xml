<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_0_5"
    android:paddingTop="@dimen/size_0_5"
    android:paddingEnd="@dimen/size_0_5"
    android:paddingBottom="@dimen/size_1_5"
    android:importantForAccessibility="no"
    android:background="@drawable/shape_aroundinfo"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/popup_info_emergency_icon"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/size_17"
        android:layout_marginTop="@dimen/size_22"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_popup_emergency"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_emergency_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_9"
        android:maxLines="1"
        android:text="긴급차량 접근중"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoBold.Red.Size18"
        app:layout_constraintStart_toEndOf="@id/popup_info_emergency_icon"
        app:layout_constraintTop_toTopOf="@id/popup_info_emergency_icon"
        app:layout_constraintBottom_toBottomOf="@id/popup_info_emergency_icon" />

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_emergency_remain_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:layout_marginEnd="@dimen/size_16"
        android:maxLines="1"
        android:text=""
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoBold.BlueGray950.Size18"
        app:layout_constraintStart_toStartOf="@+id/popup_info_emergency_title"
        app:layout_constraintTop_toBottomOf="@+id/popup_info_emergency_title" />

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_emergency_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8"
        android:text=""
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.BlueGray600.Size16"
        app:layout_constraintStart_toStartOf="@+id/popup_info_emergency_remain_dist"
        app:layout_constraintTop_toBottomOf="@+id/popup_info_emergency_remain_dist" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/popup_info_emergency_btn_constraint_layout"
        android:background="@color/neutral_6" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_info_emergency_btn_constraint_layout"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:background="@color/gray_250"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:id="@+id/close_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            app:layout_constraintHorizontal_weight="0.39"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:importantForAccessibility="no"
                android:layout_centerInParent="true" >

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/popup_info_emergency_btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/size_0_5"
                    android:layout_marginTop="@dimen/size_0_5"
                    android:gravity="center"
                    android:text="@string/aroundinfo_navigate_ok"
                    android:importantForAccessibility="no"
                    style="@style/NaviRobotoMedium.Cool.Size16" />

                <RelativeLayout
                    android:id="@+id/popup_info_emergency_btn_progress_layout"
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:layout_marginLeft="@dimen/size_8"
                    android:importantForAccessibility="no"
                    android:visibility="gone">

                    <com.kakaomobility.knsdk.ui.view.KNCircleProgress
                        android:id="@+id/popup_info_emergency_btn_progress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        app:c_unfinished_stroke_width="@dimen/size_2"
                        app:c_finished_stroke_width="@dimen/size_2"
                        app:c_progress="0"
                        app:c_circle_starting_degree="-90"
                        app:c_finished_color="@color/cool"
                        app:c_unfinished_color="@color/white" />

                    <com.kakaomobility.knsdk.ui.view.KNTextView
                        android:id="@+id/popup_info_emergency_btn_count_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="10"
                        android:importantForAccessibility="no"
                        style="@style/NaviRobotoBold.Cool.Size14"/>

                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>