<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/routeinfo_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

<!--    <include-->
<!--        layout="@layout/view_route_info_layout"-->
<!--        android:id="@+id/view_route_info_layout"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="@dimen/size_1" />-->

    <View
        android:id="@+id/top_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_1"
        android:background="@color/gray_200"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/destinfo_route_primary" />

    <include
        layout="@layout/view_route_info_button"
        android:id="@+id/destinfo_route_primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_68"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/top_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/destinfo_route_secondary" />

    <include
        layout="@layout/view_route_info_button"
        android:id="@+id/destinfo_route_secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_68"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/destinfo_route_primary"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/route_choose_btn" />

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/route_choose_btn"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_55"
        android:scaleType="center"
        android:background="#3183ea"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/routinfo_activity_select"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="@dimen/size_16"
        android:includeFontPadding="false"
        android:focusable="true"
        android:contentDescription="이 경로 선택"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="이 경로 선택"/>

</androidx.constraintlayout.widget.ConstraintLayout>
