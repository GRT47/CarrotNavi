<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_0_5"
    android:paddingTop="@dimen/size_0_5"
    android:paddingEnd="@dimen/size_0_5"
    android:paddingBottom="@dimen/size_1_5"
    android:background="@drawable/shape_aroundinfo"
    android:importantForAccessibility="no"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_22"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/popup_info_accident_icon"
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:layout_marginStart="@dimen/size_17"
            android:importantForAccessibility="no"
            android:src="@drawable/yugo_accident" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_accident_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_9"
            android:layout_marginEnd="@dimen/size_17"
            android:maxLines="2"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            style="@style/NaviRobotoBold.BlueGray950.Size18"
            android:layout_toRightOf="@+id/popup_info_accident_icon" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_accident_addr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_13"
            android:layout_marginEnd="@dimen/size_16"
            android:maxLines="1"
            style="@style/NaviNotoRegular.BlueGray600.Size16"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:layout_below="@+id/popup_info_accident_title"
            android:layout_alignStart="@+id/popup_info_accident_title" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_accident_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8"
            android:layout_marginRight="@dimen/size_50"
            android:importantForAccessibility="no"
            style="@style/NaviNotoRegular.BlueGray500.Size16"
            android:layout_below="@+id/popup_info_accident_addr"
            android:layout_alignStart="@+id/popup_info_accident_addr" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/popup_info_accident_btn_constraint_layout"
        android:background="@color/neutral_6" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_info_accident_btn_constraint_layout"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:background="@color/gray_250"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:id="@+id/close_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            app:layout_constraintHorizontal_weight="0.39"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" >

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:id="@+id/popup_info_accident_btn_close"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:importantForAccessibility="no"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/size_0_5"
                android:layout_marginTop="@dimen/size_0_5"
                android:gravity="center"
                android:text="@string/aroundinfo_navigate_ok"
                style="@style/NaviRobotoMedium.Cool.Size16" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>