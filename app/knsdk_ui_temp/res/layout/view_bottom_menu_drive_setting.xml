<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/selector_bottom_menu_default_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bottom_menu_drive_setting_icon"
        android:layout_width="@dimen/size_34"
        android:layout_height="@dimen/size_34"
        android:layout_marginTop="@dimen/size_17"
        android:layout_marginBottom="@dimen/size_7"
        android:src="@drawable/ic_drive_menu_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_menu_drive_setting_title">

    </androidx.appcompat.widget.AppCompatImageView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/bottom_menu_drive_setting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_7"
        android:layout_marginBottom="@dimen/size_21"
        android:text="@string/bottom_menu_drive_setting"
        style="@style/NaviRobotoMedium.Gray900.Size16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottom_menu_drive_setting_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

</androidx.constraintlayout.widget.ConstraintLayout>