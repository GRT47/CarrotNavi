<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:importantForAccessibility="no"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_drive_result_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/size_48"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_drive_result_constraint_layout"
            android:layout_width="@dimen/size_280"
            android:layout_height="@dimen/size_232"
            android:background="@drawable/shape_driving_popup_bg"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dialog_result_layout"
                android:layout_width="@dimen/size_280"
                android:layout_height="match_parent"
                android:focusable="false"
                android:paddingStart="@dimen/size_27"
                android:paddingEnd="@dimen/size_27"
                android:paddingTop="@dimen/size_28"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/dialog_drive_result_bottom_guideline">

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/dialog_main_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="운전 점수를 쌓아 \n보험 할인 받아보세요"
                    android:textColor="#066AEB"
                    android:textStyle="bold"
                    android:textSize="@dimen/size_24"
                    android:lineSpacingExtra="-0.25dp"
                    android:lineHeight="@dimen/size_20"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/dialog_drive_result_dist_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text=""
                    android:textSize="@dimen/size_22"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toTopOf="@+id/dialog_drive_result_toll_fee_text_label"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <View
                    android:id="@+id/dialog_drive_result_text_divider"
                    android:layout_width="@dimen/size_1"
                    android:layout_height="@dimen/size_13"
                    android:layout_marginStart="@dimen/size_10"
                    android:background="#e3e3e3"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="@id/dialog_drive_result_dist_text"
                    app:layout_constraintStart_toEndOf="@id/dialog_drive_result_dist_text"
                    app:layout_constraintEnd_toStartOf="@id/dialog_drive_result_drive_time"
                    app:layout_constraintBottom_toBottomOf="@id/dialog_drive_result_dist_text" />

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/dialog_drive_result_drive_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:textColor="@color/black"
                    android:includeFontPadding="false"
                    android:text=""
                    android:importantForAccessibility="no"
                    android:textSize="@dimen/size_22"
                    android:layout_marginStart="@dimen/size_10"
                    app:layout_constraintTop_toTopOf="@id/dialog_drive_result_dist_text"
                    app:layout_constraintStart_toEndOf="@id/dialog_drive_result_text_divider"
                    app:layout_constraintBottom_toBottomOf="@id/dialog_drive_result_dist_text" />

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/dialog_drive_result_toll_fee_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_17"
                    android:text=""
                    android:paddingBottom="@dimen/size_80"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/dialog_drive_result_dist_text">

                </com.kakaomobility.knsdk.ui.view.KNTextView>

                <com.kakaomobility.knsdk.ui.view.KNTextView
                    android:id="@+id/dialog_drive_result_toll_fee_text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_20_5"
                    android:includeFontPadding="false"
                    android:textColor="@color/black"
                    android:text=""
                    android:textSize="@dimen/size_17"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="@dimen/size_10"
                    app:layout_constraintTop_toTopOf="@id/dialog_drive_result_toll_fee_text_label"
                    app:layout_constraintStart_toEndOf="@id/dialog_drive_result_toll_fee_text_label">

                </com.kakaomobility.knsdk.ui.view.KNTextView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/dialog_drive_result_bottom_guideline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_0_5"
                android:background="#2E000000"
                android:layout_marginBottom="@dimen/size_58"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_58"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dialog_drive_result_bottom_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_margin="@dimen/size_1"
                android:background="@drawable/shape_drive_popup_close_btn_bg" >

                <RelativeLayout
                    android:id="@+id/dialog_drive_result_check_score_btn"
                    android:layout_width="@dimen/size_154"
                    android:layout_height="@dimen/size_58">

                    <com.kakaomobility.knsdk.ui.view.KNTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="운전 점수 확인"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:textSize="@dimen/size_16"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black" />

                    <View
                        android:layout_width="@dimen/size_0_5"
                        android:layout_height="match_parent"
                        android:background="#2E000000"
                        android:layout_alignParentRight="true" />

                </RelativeLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dialog_drive_result_close_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_58"
                    android:layout_marginEnd="@dimen/size_0_5"
                    android:layout_marginBottom="@dimen/size_0_5"
                    android:focusable="false"
                    android:contentDescription="체크인 팝업 닫기"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dialog_drive_result_bottom_guideline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.kakaomobility.knsdk.ui.view.KNTextView
                        android:id="@+id/dialog_drive_result_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:textSize="@dimen/size_16"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/dialog_drive_result_progress_container"
                        app:layout_constraintBottom_toBottomOf="parent">

                    </com.kakaomobility.knsdk.ui.view.KNTextView>

                    <FrameLayout
                        android:id="@+id/dialog_drive_result_progress_container"
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:layout_marginLeft="@dimen/size_5"
                        android:layout_marginStart="@dimen/size_5"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toEndOf="@id/dialog_drive_result_text_view"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.kakaomobility.knsdk.ui.view.KNCircleProgress
                            android:id="@+id/dialog_drive_result_progress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            app:c_unfinished_stroke_width="@dimen/size_2"
                            app:c_finished_stroke_width="@dimen/size_2"
                            app:c_progress="10"
                            android:importantForAccessibility="no"
                            app:c_circle_starting_degree="-90"
                            app:c_finished_color="@color/white"
                            app:c_unfinished_color="@color/color_4f647d">

                        </com.kakaomobility.knsdk.ui.view.KNCircleProgress>

                        <com.kakaomobility.knsdk.ui.view.KNTextView
                            android:id="@+id/dialog_drive_result_count_text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:gravity="center"
                            android:textColor="@color/color_151515"
                            android:textSize="@dimen/size_12">

                        </com.kakaomobility.knsdk.ui.view.KNTextView>

                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/dialog_drive_result_checkin_img_bottom_guide"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_1"
            android:layout_marginBottom="@dimen/size_93"
            app:layout_constraintLeft_toLeftOf="parent"
            android:importantForAccessibility="no"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/dialog_drive_result_constraint_layout">

        </View>

        <ImageView
            android:id="@+id/dialog_drive_result_arrive_img_view"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            app:layout_constraintWidth_max="@dimen/size_360"
            android:src="@drawable/kn_navi_view_component_driving_result_view_icon_0"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_drive_result_checkin_img_bottom_guide"
            app:layout_constraintDimensionRatio="1.92513369">

        </ImageView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/dialog_drive_result_close_bottom_view"
        android:layout_width="@dimen/size_48"
        android:layout_height="@dimen/size_48"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/dialog_drive_result_background"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>