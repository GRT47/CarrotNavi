<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sign_auxiliary_caution"
        android:layout_width="@dimen/size_82"
        android:layout_height="@dimen/size_34"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sign_auxiliary_camera"
        android:layout_width="@dimen/size_82"
        android:layout_height="@dimen/size_30"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/sign_auxiliary_camera_remain_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/NaviRobotoBold.White.Size24"
            android:importantForAccessibility="no"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sign_auxiliary_camera_remain_dist_unit"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/sign_auxiliary_camera_remain_dist_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            style="@style/NaviRobotoBold.White.Size22"
            app:layout_constraintBaseline_toBaselineOf="@id/sign_auxiliary_camera_remain_dist"
            app:layout_constraintStart_toEndOf="@id/sign_auxiliary_camera_remain_dist"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/sign_bus_auxiliary_camera"
        android:layout_width="@dimen/size_85"
        android:layout_height="@dimen/size_44"
        android:layout_marginLeft="@dimen/minus_size_2"
        android:visibility="gone"
        android:background="@drawable/img_sign_bus_lane"
        android:importantForAccessibility="no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sign_auxiliary_camera"/>

    <ImageView
        android:id="@+id/sign_back_camera"
        android:layout_width="@dimen/size_82"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/minus_size_1"
        android:visibility="gone"
        android:background="@drawable/img_sign_1105"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sign_auxiliary_camera"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sign_auxiliary_section"
        android:layout_width="@dimen/size_82"
        android:layout_height="@dimen/size_88"
        android:background="@drawable/shape_sign_auxiliary_default_large"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/sign_back_camera"
        app:layout_constraintStart_toStartOf="parent" >

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/sign_auxiliary_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_5"
            android:text="@string/sign_auxiliary_large_title"
            android:textSize="@dimen/size_14"
            app:naviFontType="PRETENDARD_MEDIUM"
            android:textColor="@color/yellow"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/sign_auxiliary_section_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_2"
            android:text="99"
            android:textSize="@dimen/size_32"
            android:textStyle="bold"
            app:naviFontType="PRETENDARD_MEDIUM"
            android:textColor="@color/yellow"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_auxiliary_section_title"
            app:layout_constraintBottom_toTopOf="@+id/sign_auxiliary_section_remain_time_layout"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/sign_auxiliary_section_remain_time_layout"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/size_5"
            app:layout_constraintBottom_toBottomOf="parent"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" >

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:id="@+id/sign_auxiliary_section_remain_time_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="00:00 남음"
                android:textSize="@dimen/size_14"
                app:naviFontType="PRETENDARD_MEDIUM"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>