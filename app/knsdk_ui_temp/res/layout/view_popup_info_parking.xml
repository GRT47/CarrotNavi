<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/size_0_5"
    android:paddingTop="@dimen/size_0_5"
    android:paddingEnd="@dimen/size_0_5"
    android:paddingBottom="@dimen/size_1_5"
    android:importantForAccessibility="no"
    android:background="@drawable/shape_aroundinfo"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/popup_info_parking_icon"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/size_16"
        android:layout_marginTop="@dimen/size_20"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.AppCompatImageView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_parking_title"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginEnd="@dimen/size_16"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoBold.Black.Size18"
        app:layout_constraintStart_toEndOf="@id/popup_info_parking_icon"
        app:layout_constraintTop_toTopOf="@id/popup_info_parking_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/popup_info_parking_icon">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_parking_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6"
        android:importantForAccessibility="no"
        style="@style/NaviRobotoBold.Red.Size19"
        app:layout_constraintStart_toStartOf="@id/popup_info_parking_title"
        app:layout_constraintTop_toBottomOf="@id/popup_info_parking_title">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_parking_address"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_5"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.Gray500.Size13"
        app:layout_constraintStart_toStartOf="@id/popup_info_parking_title"
        app:layout_constraintTop_toBottomOf="@id/popup_info_parking_dist"
        app:layout_constraintEnd_toEndOf="@id/popup_info_parking_title">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_parking_type_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_13"
        android:layout_marginStart="@dimen/size_48"
        android:layout_marginEnd="@dimen/size_13"
        android:maxLines="2"
        android:importantForAccessibility="no"
        style="@style/NaviNotoRegular.Gray800.Size15"
        app:layout_constraintStart_toStartOf="@id/popup_info_parking_address"
        app:layout_constraintTop_toBottomOf="@id/popup_info_parking_address">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <com.kakaomobility.knsdk.ui.view.KNTextView
        android:id="@+id/popup_info_parking_type_second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/NaviNotoRegular.Gray800.Size15"
        android:layout_marginStart="@dimen/size_48"
        android:layout_marginEnd="@dimen/size_13"
        android:maxLines="2"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/popup_info_parking_type_first"
        app:layout_constraintTop_toBottomOf="@id/popup_info_parking_type_first">

    </com.kakaomobility.knsdk.ui.view.KNTextView>

    <LinearLayout
        android:id="@+id/popup_info_parking_btn_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:background="@color/gray_250"
        android:orientation="horizontal"
        android:weightSum="2"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_parking_btn_add_via"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_goal"
            android:importantForAccessibility="no"
            android:background="@drawable/selector_via_close_bg"
            style="@style/NaviNotoRegular.Gray900.Size18" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_parking_btn_reserve"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/size_0_5"
            android:layout_marginTop="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_reserve"
            android:background="@drawable/selector_via_close_bg"
            android:importantForAccessibility="no"
            style="@style/NaviNotoRegular.Gray900.Size18" />

        <com.kakaomobility.knsdk.ui.view.KNTextView
            android:id="@+id/popup_info_parking_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/size_0_5"
            android:layout_marginStart="@dimen/size_0_5"
            android:gravity="center"
            android:text="@string/aroundinfo_navigate_close"
            android:importantForAccessibility="no"
            android:background="@drawable/selector_via_close_bg"
            style="@style/NaviNotoRegular.Gray900.Size18" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_info_parking_reserve_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_aroundinfo"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/popup_info_parking_btn_layout" >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/popup_info_reserve_logo"
                android:layout_width="@dimen/size_32"
                android:layout_height="@dimen/size_32"
                android:src="@drawable/ic_popup_knnavi"
                android:layout_centerHorizontal="true" />

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="카카오내비에서\n주차권을 저렴하게\n예약할 수 있어요"
                android:textStyle="bold"
                android:importantForAccessibility="no"
                android:background="@drawable/selector_via_close_bg"
                android:layout_marginTop="@dimen/size_12"
                style="@style/NaviNotoRegular.Black.Size18"
                android:layout_below="@+id/popup_info_reserve_logo" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/popup_info_parking_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56"
            android:background="@color/gray_250"
            android:orientation="horizontal"
            android:weightSum="2"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent" >

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:id="@+id/popup_info_parking_move_app"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:layout_marginTop="@dimen/size_0_5"
                android:layout_marginEnd="@dimen/size_0_5"
                android:gravity="center"
                android:text="@string/aroundinfo_navigate_move_app"
                android:importantForAccessibility="no"
                android:background="@drawable/selector_via_close_bg"
                style="@style/NaviNotoRegular.Gray900.Size18" />

            <com.kakaomobility.knsdk.ui.view.KNTextView
                android:id="@+id/popup_info_parking_close"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:layout_marginTop="@dimen/size_0_5"
                android:layout_marginStart="@dimen/size_0_5"
                android:gravity="center"
                android:text="@string/aroundinfo_navigate_close"
                android:background="@drawable/selector_via_close_bg"
                style="@style/NaviNotoRegular.Gray900.Size18" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>