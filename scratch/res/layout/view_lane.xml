<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                            
    
                                          
                 
                              
                             
                 
                                  
                             
                 
                                   
                             
           
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:tag="layout/view_lane_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:bitdraw="http://schemas.android.com/apk/res-auto">

        <com.tmapmobility.tmap.tmapsdk.ui.view.CustomTextView
            android:id="@+id/lane_distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:gravity="center"
            android:padding="@dimen/tmap_3dp"
            android:fontFamily="@font/roboto_bold"
            bitdraw:textStroke="true"
            android:tag="binding_1"                                                           
            bitdraw:textStrokeWidth="@dimen/tmap_3dp"
                                                                                        
            android:textSize="@dimen/tmap_18dp" />

        <LinearLayout
            android:id="@+id/left_pocket_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tmap_43dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/lane_distance_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="top"
            android:background="@drawable/lane_bg_pocket_a"
            android:tag="binding_2"                                           />

        <LinearLayout
            android:id="@+id/center_lane_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tmap_43dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:tag="binding_3"                      
                                                           
            app:layout_constraintTop_toBottomOf="@id/lane_distance_text"
            app:layout_constraintLeft_toRightOf="@id/left_pocket_layout"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <LinearLayout
            android:id="@+id/right_pocket_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tmap_43dp"
            android:orientation="horizontal"
            android:gravity="top"
            app:layout_constraintTop_toBottomOf="@id/lane_distance_text"
            app:layout_constraintLeft_toRightOf="@id/center_lane_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/lane_bg_pocket_b"
            android:tag="binding_4"                                            />

    </androidx.constraintlayout.widget.ConstraintLayout>
         