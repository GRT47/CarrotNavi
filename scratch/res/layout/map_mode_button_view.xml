<?xml version="1.0" encoding="utf-8"?>

                                                        
    
                                                                          
                                                                                                                 
                 
                              
                            
                 
                           
                        
                 
                           
                                                                                                              
           
    <RelativeLayout
        android:id="@+id/map_view_mode_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tmap_56dp" android:tag="layout/map_mode_button_view_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/icon_drive_image_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tmap_56dp"
            android:layout_alignParentRight="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_drive_3d_image"
                android:layout_width="@dimen/tmap_56dp"
                android:layout_height="@dimen/tmap_56dp"
                android:tag="binding_1"                     
                                                                                          
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                                                                                                                                />

            <ImageView
                android:id="@+id/icon_drive_2d_image"
                android:layout_width="@dimen/tmap_48dp"
                android:layout_height="@dimen/tmap_56dp"
                android:tag="binding_2"                     
                                                                                        
                app:layout_constraintLeft_toRightOf="@id/icon_drive_3d_image"
                app:layout_constraintTop_toTopOf="parent"
                                                                                                                                />

            <View
                android:layout_width="@dimen/tmap_1dp"
                android:layout_height="@dimen/tmap_48dp"
                app:layout_constraintLeft_toRightOf="@id/icon_drive_3d_image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/tmap_2dp"
                android:tag="binding_3"                                                        />

            <ImageView
                android:id="@+id/icon_drive_n_image"
                android:layout_width="@dimen/tmap_48dp"
                android:layout_height="@dimen/tmap_56dp"
                android:tag="binding_4"                     
                                                                                            
                app:layout_constraintLeft_toRightOf="@id/icon_drive_2d_image"
                app:layout_constraintTop_toTopOf="parent"
                                                                                                                                      />

            <View
                android:layout_width="@dimen/tmap_1dp"
                android:layout_height="@dimen/tmap_48dp"
                app:layout_constraintLeft_toRightOf="@id/icon_drive_2d_image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/tmap_2dp"
                android:tag="binding_5"                                                        />

            <ImageView
                android:id="@+id/icon_drive_cancel_image"
                android:layout_width="@dimen/tmap_52dp"
                android:layout_height="@dimen/tmap_56dp"
                android:tag="binding_6"                     
                app:layout_constraintLeft_toRightOf="@id/icon_drive_n_image"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                                                                                                                                      />

            <View
                android:layout_width="@dimen/tmap_1dp"
                android:layout_height="@dimen/tmap_48dp"
                app:layout_constraintLeft_toRightOf="@id/icon_drive_n_image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/tmap_2dp"
                android:tag="binding_7"                                                        />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- View mode View -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/map_view_mode_button"
            android:layout_width="@dimen/tmap_56dp"
            android:layout_height="@dimen/tmap_56dp"
            android:layout_alignParentRight="true"
            android:tag="binding_8"                                                                                                              >

            <ImageView
                android:id="@+id/map_view_mode_button_image"
                android:layout_width="@dimen/tmap_56dp"
                android:layout_height="@dimen/tmap_56dp"
                android:layout_alignParentRight="true"
                android:tag="binding_9"                     
                                                  
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                                            />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>
         