    <!-- 미니 모드 루트 레이아웃 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/highway_mini_mode_root_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:tag="layout/highway_mini_mode_view_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <!-- ========================================== -->
        <!-- 출구 카드                                    -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/highway_mini_exit_layout"
            android:layout_width="@dimen/tmap_150dp"
            android:layout_height="@dimen/tmap_98dp"
            android:alpha="0.98"
            android:tag="binding_1"                                                                                                              
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@drawable/highway_mini_mode_card_background">

            <!-- 출구 아이콘 -->
            <ImageView
                android:id="@+id/highway_mini_exit_img"
                android:layout_width="@dimen/tmap_25dp"
                android:layout_height="@dimen/tmap_25dp"
                android:layout_marginTop="@dimen/tmap_10dp"
                android:layout_marginRight="@dimen/tmap_10dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/icn_highway_tbt_goal" />

            <!-- 출구 이름 -->
            <TextView
                android:id="@+id/highway_mini_exit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                android:layout_marginTop="@dimen/tmap_12dp"
                android:layout_marginRight="@dimen/tmap_7dp"
                android:ellipsize="end"
                android:fontFamily="@font/skp_go_bm"
                android:maxLines="1"
                android:tag="binding_2"                  
                android:textColor="@color/color_ffffff"
                android:textSize="@dimen/tmap_18dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/highway_mini_exit_img"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="신탄진TG" />

            <!-- 남은 거리 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/highway_mini_exit_distance_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/highway_mini_exit_distance_digit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_28dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:tag="binding_3"                          
                    tools:text="143" />

                <TextView
                    android:id="@+id/highway_mini_exit_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tmap_2dp"
                    android:layout_marginBottom="@dimen/tmap_5dp"
                    android:fontFamily="@font/skp_go_bm"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/highway_mini_exit_distance_digit"
                    android:tag="binding_4"                               
                    tools:text="km" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 통행료 -->
            <TextView
                android:id="@+id/highway_mini_exit_fee_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                android:layout_marginBottom="@dimen/tmap_10dp"
                android:fontFamily="@font/skp_go_bm"
                android:tag="binding_5"                  
                android:textColor="@color/color_fff356"
                android:textSize="@dimen/tmap_14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                tools:text="요금 10,000원" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========================================== -->
        <!-- 휴게소 카드                                   -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/highway_mini_service_area_layout"
            android:layout_width="@dimen/tmap_150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tmap_6dp"
            android:alpha="0.98"
            android:tag="binding_6"                                                                                                              
            android:paddingBottom="@dimen/tmap_10dp"
                                                                                      
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/highway_mini_exit_layout"
            tools:background="@drawable/highway_mini_mode_card_background">

            <!-- 휴게소 이름 -->
            <TextView
                android:id="@+id/highway_mini_service_area_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                android:layout_marginTop="@dimen/tmap_12dp"
                android:layout_marginRight="@dimen/tmap_12dp"
                android:ellipsize="end"
                android:fontFamily="@font/skp_go_bm"
                android:maxLines="1"
                android:tag="binding_7"                  
                android:textColor="@color/color_ffffff"
                android:textSize="@dimen/tmap_18dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="기흥휴게소" />

            <!-- 남은 거리 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/highway_mini_service_area_distance_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                android:layout_marginTop="@dimen/tmap_4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/highway_mini_service_area_text">

                <TextView
                    android:id="@+id/highway_mini_service_area_distance_digit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:tag="binding_8"                          
                    tools:text="234" />

                <TextView
                    android:id="@+id/highway_mini_service_area_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tmap_2dp"
                    android:layout_marginBottom="@dimen/tmap_5dp"
                    android:fontFamily="@font/skp_go_bm"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/highway_mini_service_area_distance_digit"
                    android:tag="binding_9"                               
                    tools:text="km" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 주유소 브랜드 아이콘 -->
            <ImageView
                android:id="@+id/highway_mini_service_area_corp_icon"
                android:layout_width="@dimen/tmap_30dp"
                android:layout_height="@dimen/tmap_30dp"
                android:layout_marginRight="@dimen/tmap_14dp"
                android:tag="binding_10"                                                                                               
                app:layout_constraintBottom_toBottomOf="@id/highway_mini_service_area_distance_layout"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/highway_mini_service_area_distance_layout"
                                                                     />

            <!-- EV 충전 아이콘 + 타입 텍스트 -->
            <LinearLayout
                android:id="@+id/highway_mini_service_area_ev_icon_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/tmap_14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="binding_11"                                                                                              
                app:layout_constraintBottom_toBottomOf="@id/highway_mini_service_area_distance_layout"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/highway_mini_service_area_distance_layout">

                <ImageView
                    android:layout_width="@dimen/tmap_22dp"
                    android:layout_height="@dimen/tmap_22dp"
                    android:src="@drawable/icn_highway_mini_electric" />

                <TextView
                    android:id="@+id/highway_mini_service_area_ev_type_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tmap_2dp"
                    android:fontFamily="@font/skp_go_bm"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_f0f0f0"
                    android:textSize="@dimen/tmap_13dp"
                    android:tag="binding_12"                                            />

            </LinearLayout>

            <!-- 주유/EV/화장실 정보 컨테이너 -->
            <FrameLayout
                android:id="@+id/highway_mini_service_area_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_14dp"
                android:layout_marginTop="@dimen/tmap_4dp"
                android:layout_marginRight="@dimen/tmap_14dp"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/highway_mini_service_area_distance_layout"
                tools:visibility="visible">

                <!-- 마지막 휴게소 텍스트 -->
                <TextView
                    android:id="@+id/highway_mini_service_area_last_text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tmap_30dp"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/skp_go_bm"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/tag_driving_highway_last_service_area"
                    android:textColor="@color/color_bbbbbb"
                    android:textSize="@dimen/tmap_14dp"
                    android:visibility="gone" />

                <!-- 주유 정보 레이아웃 -->
                <LinearLayout
                    android:id="@+id/highway_mini_service_area_fuel_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tmap_30dp"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- 유종 아이콘 -->
                    <ImageView
                        android:id="@+id/highway_mini_service_area_fuel_type_img"
                        android:layout_width="@dimen/tmap_22dp"
                        android:layout_height="@dimen/tmap_22dp"
                        android:tag="binding_13"                                                                                                />

                    <!-- 유가 텍스트 -->
                    <TextView
                        android:id="@+id/highway_mini_service_area_oil_price_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_4dp"
                        android:fontFamily="@font/skp_go_bm"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_f0f0f0"
                        android:textSize="@dimen/tmap_13dp"
                        android:tag="binding_14"                                                                                               
                        tools:text="1,650" />

                    <!-- EV 충전 상세 정보 (전기차 유종일 때) -->
                    <LinearLayout
                        android:id="@+id/highway_mini_service_area_electric_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:tag="binding_15"                                                                                                                                               >

                        <ImageView
                            android:id="@+id/highway_mini_service_area_electric_img"
                            android:layout_width="@dimen/tmap_30dp"
                            android:layout_height="@dimen/tmap_30dp"
                            android:src="@drawable/icn_highway_mini_electric" />

                        <TextView
                            android:id="@+id/highway_mini_service_area_electric_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_4dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_f0f0f0"
                            android:textSize="@dimen/tmap_13dp"
                            android:tag="binding_16"                                            />

                    </LinearLayout>

                    <!-- Tesla SuperCharger 아이콘 (Tesla 전용 충전소일 때만 표시) -->
                    <ImageView
                        android:id="@+id/highway_mini_service_area_tesla_img"
                        android:layout_width="@dimen/tmap_30dp"
                        android:layout_height="@dimen/tmap_30dp"
                        android:src="@drawable/icn_highway_mini_electric_tesla"
                        android:tag="binding_17"                                                                                                                                                                                                                                                                                                                                                                                                              />

                </LinearLayout>

                <!-- 화장실 혼잡도 레이아웃 -->
                <LinearLayout
                    android:id="@+id/highway_mini_service_area_restroom_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tmap_30dp"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- 여자 화장실 -->
                    <LinearLayout
                        android:id="@+id/highway_mini_service_area_female_restroom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/tmap_14dp"
                            android:layout_height="@dimen/tmap_14dp"
                            android:src="@drawable/girl_restroom_icon" />

                        <TextView
                            android:id="@+id/highway_mini_service_area_female_restroom_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_2dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/tmap_13dp" />

                    </LinearLayout>

                    <!-- 남자 화장실 -->
                    <LinearLayout
                        android:id="@+id/highway_mini_service_area_male_restroom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/tmap_14dp"
                            android:layout_height="@dimen/tmap_14dp"
                            android:src="@drawable/boy_restroom_icon" />

                        <TextView
                            android:id="@+id/highway_mini_service_area_male_restroom_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_2dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/tmap_13dp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

         