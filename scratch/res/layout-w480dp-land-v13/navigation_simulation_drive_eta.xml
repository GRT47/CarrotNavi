<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/NavigationEta.CardView.Day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.MaterialComponents.Light"
    app:cardElevation="@dimen/tmap_4dp"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/tmap_16dp"
        android:paddingTop="@dimen/tmap_4dp"
        android:paddingEnd="@dimen/tmap_16dp"
        android:paddingBottom="@dimen/tmap_4dp">

        <!-- 좌측: 시뮬레이션 반복 버튼 -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_simulation_repeat"
            style="@style/NavigationEta.IconButton.Day"
            android:layout_width="@dimen/navigation_eta_icon_button_size"
            android:layout_height="@dimen/navigation_eta_icon_button_size"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_repeat_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 중앙: 시간 표시 -->
        <com.tmapmobility.tmap.tmapsdk.ui.view.eta.NavigationEtaTime
            android:id="@+id/eta_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tmap_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_distance_value"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/btn_simulation_repeat"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 중앙: 거리 값 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_distance_value"
            style="@style/NavigationEta.DistanceText.Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tmap_16dp"
            android:fontFamily="@font/tmobi_heavy"
            android:gravity="bottom"
            android:letterSpacing="@dimen/navigation_eta_value_text_line_spacing"
            android:textSize="@dimen/navigation_eta_distance_value_text_size"
            app:layout_constraintBottom_toBottomOf="@id/eta_time"
            app:layout_constraintEnd_toStartOf="@id/tv_distance_unit"
            app:layout_constraintStart_toEndOf="@id/eta_time"
            app:layout_constraintTop_toTopOf="@id/eta_time"
            tools:text="65" />

        <!-- 중앙: 거리 단위 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_distance_unit"
            style="@style/NavigationEta.DistanceText.Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tmap_2dp"
            android:layout_marginEnd="@dimen/tmap_12dp"
            android:fontFamily="@font/tmobi_medium"
            android:gravity="bottom"
            android:textSize="@dimen/navigation_eta_distance_unit_text_size"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_distance_value"
            app:layout_constraintEnd_toStartOf="@id/center_guideline"
            app:layout_constraintStart_toEndOf="@id/tv_distance_value"
            tools:text="km" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/center_guideline"
            android:layout_width="@dimen/tmap_0dp"
            android:layout_height="@dimen/tmap_0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/center_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tv_distance_unit,center_guideline" />

        <!-- 중앙: 이름 텍스트 영역 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layout_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_end_simulation"
            app:layout_constraintStart_toEndOf="@id/center_barrier"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_name"
                style="@style/NavigationEta.NameText.Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tmap_12dp"
                android:layout_marginEnd="@dimen/tmap_24dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/tmobi_medium"
                android:gravity="center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="@dimen/navigation_eta_name_text_size"
                tools:drawablePadding="@dimen/tmap_2dp"
                tools:drawableStart="@drawable/navigation_eta_road_icon"
                tools:text="서울시 중구 을지로" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 우측: 시뮬레이션 종료 버튼 -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_end_simulation"
            style="@style/NavigationEta.IconButton.Day"
            android:layout_width="@dimen/navigation_eta_icon_button_size"
            android:layout_height="@dimen/navigation_eta_icon_button_size"
            android:layout_marginStart="@dimen/tmap_24dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_exit_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
