<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/NavigationEta.CardView.Day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.MaterialComponents.Light"
    app:cardElevation="@dimen/tmap_4dp"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/tmap_16dp"
        android:paddingTop="@dimen/tmap_4dp"
        android:paddingEnd="@dimen/tmap_16dp"
        android:paddingBottom="@dimen/tmap_4dp">

        <!-- 좌측: 다음 경유지로 버튼 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next_waypoint"
            android:layout_width="@dimen/tmap_0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/tmap_12dp"
            android:background="@drawable/navigation_eta_end_of_drive_button_background"
            android:fontFamily="@font/tmobi_bold"
            android:maxWidth="@dimen/tmap_200dp"
            android:minWidth="@dimen/tmap_0dp"
            android:minHeight="@dimen/tmap_0dp"
            android:padding="@dimen/tmap_6dp"
            android:stateListAnimator="@null"
            android:text="@string/navigation_eta_next_direction"
            android:textColor="@color/white"
            android:textSize="@dimen/tmap_13dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/center_guideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/tmap_200dp"
            app:layout_constraintWidth_min="@dimen/tmap_105dp"
            tools:ignore="SpUsage" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/center_guideline"
            android:layout_width="@dimen/tmap_0dp"
            android:layout_height="@dimen/tmap_0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/center_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="btn_next_waypoint,center_guideline" />

        <!-- 중앙: 경유지 이름 텍스트 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_waypoint_name"
            style="@style/NavigationEta.NameText.Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tmap_12dp"
            android:layout_marginEnd="@dimen/tmap_24dp"
            android:ellipsize="end"
            android:fontFamily="@font/tmobi_medium"
            android:maxLines="1"
            android:textSize="@dimen/navigation_eta_name_text_size"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_menu"
            app:layout_constraintStart_toEndOf="@id/center_barrier"
            app:layout_constraintTop_toTopOf="parent"
            tools:drawablePadding="@dimen/tmap_2dp"
            tools:drawableStart="@drawable/navigation_eta_current_position_icon"
            tools:text="서울시 중구 을지로" />

        <!-- 우측: 메뉴 버튼 -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_menu"
            style="@style/NavigationEta.IconButton.Day"
            android:layout_width="@dimen/tmap_24dp"
            android:layout_height="@dimen/tmap_24dp"
            android:layout_marginStart="@dimen/tmap_24dp"
            android:background="@null"
            android:src="@drawable/ic_menu_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
