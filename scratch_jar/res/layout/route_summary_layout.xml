<?xml version="1.0" encoding="utf-8"?>

                                                        
    
                                                                         
                 
                          
                           
                 
                              
                           
                 
                                   
                                                                         
                 
                           
                                                                                                              
           
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" android:tag="layout/route_summary_layout_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
        <RelativeLayout
            android:id="@+id/route_summary_title_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/tmap_route_summary_detail_title_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tmap_route_detail_title_height"
                android:background="@color/tmap_common_title_bg_color"
                android:layout_gravity="top"
                android:clickable="true">

                <ImageView
                    android:id="@+id/tmap_route_summary_detail_back_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="binding_1"                     
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginRight="@dimen/tmap_main_menu_btn_margin_right_2"
                    android:background="@null"
                    android:src="@drawable/btn_backpress_selector"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:tag="binding_2"      
                    android:textColor="@color/black_color"
                    android:fontFamily="@font/skp_go_mm"
                    android:textSize="@dimen/tmap_17dp"/>

            </FrameLayout>

            <View
                android:id="@+id/route_guidance_header_shadow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tmap_7dp"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/tmap_route_detail_title_height"
                android:background="@drawable/bg_sheet_shadow"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/tmap_route_detail_list_header_height"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/white_color">
            <LinearLayout
                android:id="@+id/route_summary_footer_layout"
                android:layout_marginLeft="@dimen/tmap_19dp"
                android:layout_marginRight="@dimen/tmap_18dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/tmap_16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tmap_route_summary_detail_list_content_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="@font/skp_go_bm"
                        android:textColor="@color/black_color"
                        android:textSize="@dimen/tmap_23dp"
                        android:tag="binding_3"                                  />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_5dp"
                        android:layout_marginRight="@dimen/tmap_5dp"
                        android:fontFamily="@font/skp_go_mm"
                        android:text="@string/ai_route_option_separate_string"
                        android:textColor="@color/color_b6b6b6"
                        android:textSize="@dimen/tmap_14dp"/>

                    <TextView
                        android:id="@+id/tmap_route_summary_detail_list_content_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="@font/skp_go_mm"
                        android:textColor="@color/black_color"
                        android:textSize="@dimen/tmap_16dp"
                        android:tag="binding_4"                                                          />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_5dp"
                        android:layout_marginRight="@dimen/tmap_5dp"
                        android:fontFamily="@font/skp_go_mm"
                        android:text="@string/ai_route_option_separate_string"
                        android:textColor="@color/color_b6b6b6"
                        android:textSize="@dimen/tmap_14dp"/>

                    <TextView
                        android:id="@+id/tmap_route_summary_detail_list_content_fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/skp_go_mm"
                        android:textColor="@color/black_color"
                        android:tag="binding_5"                   
                        android:textSize="@dimen/tmap_16dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tmap_route_summary_detail_list_content_dest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tmap_8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:tag="binding_6"                      
                    android:textColor="@color/black_color"
                    android:textSize="@dimen/tmap_17dp"
                    android:fontFamily="@font/skp_go_mm"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
         