    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_confirm_dialog_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent" android:tag="layout/bottom_confirm_dialog_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_confirm_dialog_body_layout"
            android:layout_width="@dimen/tmap_0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            android:tag="binding_1"                                                                                                                                                               
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/ad_view_container"
                android:layout_width="@dimen/tmap_0dp"
                android:layout_height="@dimen/tmap_270dp"                                                                                                       
                android:paddingBottom="@dimen/tmap_20dp"
                android:scrollbars="none"
                android:tag="binding_2"                                           
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_sheet_dialog_background"
                app:layout_constrainedWidth="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ad_view_container">

                <TextView
                    android:id="@+id/bottom_confirm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:layout_marginTop="@dimen/tmap_24dp"
                    android:layout_marginLeft="@dimen/tmap_20dp"
                    android:layout_marginRight="@dimen/tmap_20dp"
                    app:layout_constraintHorizontal_bias="0"
                    android:fontFamily="@font/skp_go_bm"
                                          
                    android:textColor="@color/color_000000"
                    android:textSize="@dimen/tmap_18dp"
                    tools:text="@string/tag_driving_popup_route_guide_cancel_description" android:tag="binding_3"/>

                <TextView
                    android:id="@+id/bottom_confirm_left_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tmap_50dp"
                    app:layout_constraintTop_toBottomOf="@id/bottom_confirm_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/bottom_confirm_right_button_layout"
                    app:layout_constrainedWidth="true"
                    android:layout_marginTop="@dimen/tmap_22dp"
                    android:layout_marginLeft="@dimen/tmap_10dp"
                    android:layout_marginBottom="@dimen/tmap_10dp"
                    android:background="@drawable/navi_light_gray_button_selector"
                    android:gravity="center"
                    android:fontFamily="@font/skp_go_bm"
                    android:tag="binding_4"          
                    android:textColor="@color/color_000000"
                    android:textSize="@dimen/tmap_18dp"
                    tools:text="@string/tag_driving_popup_route_guide_cancel_tmap"
                                                                           />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bottom_confirm_right_button_layout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/tmap_50dp"
                    app:layout_constraintTop_toBottomOf="@id/bottom_confirm_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/bottom_confirm_left_button"
                    android:layout_marginTop="@dimen/tmap_22dp"
                    android:layout_marginLeft="@dimen/tmap_8dp"
                    android:layout_marginRight="@dimen/tmap_10dp"
                    android:layout_marginBottom="@dimen/tmap_10dp"
                    app:layout_constrainedWidth="true"
                    android:background="@drawable/navi_blue_button_selector"
                    android:tag="binding_5"                                >

                    <TextView
                        android:id="@+id/bottom_confirm_right_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/bottom_confirm_count_layout"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        android:fontFamily="@font/skp_go_bm"
                        android:tag="binding_6"           
                        android:textColor="@color/color_ffffff"
                        android:textSize="@dimen/tmap_18dp"
                        tools:text="@string/tag_driving_popup_route_guide_cancel_route"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/bottom_confirm_count_layout"
                        android:layout_width="@dimen/tmap_25dp"
                        android:layout_height="@dimen/tmap_25dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@id/bottom_confirm_right_button"
                        app:layout_constraintRight_toRightOf="parent"
                        android:layout_marginLeft="@dimen/tmap_7dp"
                        android:tag="binding_7"                                     >

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/loading_spinner_lottie_animation_view"
                            android:layout_width="@dimen/tmap_25dp"
                            android:layout_height="@dimen/tmap_25dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:lottie_fileName="loading_spinner_white.json"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            android:layout_marginRight="@dimen/tmap_1dp"
                            android:layout_marginBottom="@dimen/tmap_1.5dp"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="@color/color_ffffff"
                            android:textSize="@dimen/tmap_15dp"
                            android:tag="binding_8"
                            tools:text="5"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/bottom_confirm_vertical_center_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
         