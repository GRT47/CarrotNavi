    <!-- 루트: alpha 바인딩으로 스크롤 기반 투명도 조절 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
                                      android:tag="layout/highway_list_item_view_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <!-- 일반 아이템 카드 (작은 카드: 86dp 높이, 좌측 마진으로 들여쓰기) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/highway_item_layout"
            android:layout_width="@dimen/tmap_212dp"                                                                                                       
            android:layout_height="@dimen/tmap_86dp"                                                                                                     
            android:tag="binding_1"                                                                                                
            android:layout_marginBottom="@dimen/tmap_4dp"
            android:background="@drawable/highway_full_mode_card_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">

            <!-- TBT 이름 -->
            <TextView
                android:id="@+id/highway_item_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_12dp"
                android:layout_marginTop="@dimen/tmap_12dp"
                android:ellipsize="end"
                android:fontFamily="@font/skp_go_bm"
                android:maxLines="1"
                android:tag="binding_2"       
                android:textColor="@color/color_ffffff"
                android:textSize="@dimen/tmap_18dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/highway_item_exit_img"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="안성휴게소" />

            <!-- 혼잡도 바 -->
            <View
                android:id="@+id/highway_item_cong_img"
                android:layout_width="@dimen/tmap_8dp"
                android:layout_height="@dimen/tmap_62dp"                                                                                                     
                android:layout_marginRight="@dimen/tmap_12dp"
                android:tag="binding_3"               
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 화물차 쉼터 아이콘 -->
            <ImageView
                android:id="@+id/highway_item_truck_shelter_img"
                android:layout_width="@dimen/tmap_55dp"
                android:layout_height="@dimen/tmap_16dp"
                android:layout_marginLeft="@dimen/tmap_5dp"
                android:layout_marginTop="@dimen/tmap_12dp"
                android:layout_marginRight="@dimen/tmap_12dp"
                android:tag="binding_4"                                                
                app:layout_constraintRight_toLeftOf="@id/highway_item_cong_img"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- JC 방향 화살표 아이콘 -->
            <ImageView
                android:id="@+id/highway_item_exit_img"
                android:layout_width="@dimen/tmap_25dp"
                android:layout_height="@dimen/tmap_25dp"
                android:layout_marginTop="@dimen/tmap_12dp"
                android:layout_marginRight="@dimen/tmap_12dp"
                android:tag="binding_5"                                                 
                app:layout_constraintRight_toLeftOf="@id/highway_item_truck_shelter_img"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 남은 거리 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/highway_item_distance_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/tmap_12dp"
                android:layout_marginBottom="@dimen/tmap_7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@id/highway_item_cong_img">

                <TextView
                    android:id="@+id/highway_item_distance_digit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_28dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:tag="binding_6"               
                    tools:text="25" />

                <TextView
                    android:id="@+id/highway_item_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/tmap_2dp"
                    android:layout_marginBottom="@dimen/tmap_5dp"
                    android:fontFamily="@font/skp_go_bm"
                    android:textColor="@color/color_ffffff"
                    android:textSize="@dimen/tmap_15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/highway_item_distance_digit"
                    android:tag="binding_7"                    
                    tools:text="km" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 통행료 텍스트 -->
            <TextView
                android:id="@+id/highway_item_fee_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_12dp"
                android:layout_marginBottom="@dimen/tmap_12dp"
                android:fontFamily="@font/skp_go_bm"
                android:tag="binding_8"       
                android:textColor="@color/color_fff356"
                android:textSize="@dimen/tmap_14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent" />

            <!-- 주유소/EV/화장실 정보 컨테이너 -->
            <FrameLayout
                android:id="@+id/highway_item_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tmap_12dp"
                android:layout_marginBottom="@dimen/tmap_12dp"
                android:tag="binding_9"                                              
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/highway_item_fuel_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- 주유소 정보 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/highway_item_oil_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="binding_10"                                                                         
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent">

                        <ImageView
                            android:id="@+id/highway_item_oil_brand_img"
                            android:layout_width="@dimen/tmap_22dp"
                            android:layout_height="@dimen/tmap_22dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:tag="binding_11"                  />

                        <ImageView
                            android:id="@+id/highway_item_oil_type_img"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_2dp"
                            android:tag="binding_12"                 
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@id/highway_item_oil_brand_img"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/highway_item_oil_price_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_3dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:textColor="@color/color_f0f0f0"
                            android:textSize="@dimen/tmap_14dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@id/highway_item_oil_type_img"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- 휴게소일 때: EV 간단 정보 (아이콘 + 급속/완속) - 롤링됨 -->
                    <LinearLayout
                        android:id="@+id/highway_item_electric_simple_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:tag="binding_13"                                                                                                                               
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent">

                        <ImageView
                            android:layout_width="@dimen/tmap_14dp"
                            android:layout_height="@dimen/tmap_14dp"
                            android:src="@drawable/icn_highway_mini_electric" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_4dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:textColor="@color/color_f0f0f0"
                            android:textSize="@dimen/tmap_14dp"
                            android:tag="binding_14"                                 />

                    </LinearLayout>

                    <!-- 휴게소가 아닐 때: EV 상세 정보 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/highway_item_electric_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="binding_15"                                                                                                                                           
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/highway_item_electric_top_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/highway_item_electric_img"
                                android:layout_width="@dimen/tmap_14dp"
                                android:layout_height="@dimen/tmap_14dp"
                                android:src="@drawable/icn_highway_mini_electric"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/highway_item_electric_slow_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/tmap_4dp"
                                android:layout_marginTop="@dimen/tmap_1dp"
                                android:fontFamily="@font/skp_go_bm"
                                android:text="@string/electric_type_slow"
                                android:tag="binding_16"                                                                             
                                                                                                                                              
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toRightOf="@id/highway_item_electric_img"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/highway_item_electric_dc_combo_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/tmap_4dp"
                                android:layout_marginTop="@dimen/tmap_1dp"
                                android:fontFamily="@font/skp_go_bm"
                                android:text="@string/electric_type_dc_combo"
                                android:tag="binding_17"                                                                          
                                                                                                                                              
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toRightOf="@id/highway_item_electric_slow_text"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/highway_item_electric_bottom_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tmap_3dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/highway_item_electric_top_layout">

                            <TextView
                                android:id="@+id/highway_item_electric_dc_demo_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/skp_go_bm"
                                android:text="@string/electric_type_dc_demo"
                                android:tag="binding_18"                                                                        
                                                                                                                                              
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/highway_item_electric_ac_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/tmap_4dp"
                                android:fontFamily="@font/skp_go_bm"
                                android:text="@string/electric_type_ac"
                                android:tag="binding_19"                                                                      
                                                                                                                                              
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toRightOf="@id/highway_item_electric_dc_demo_text"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 화장실 혼잡도 - 롤링됨 -->
                <LinearLayout
                    android:id="@+id/highway_item_restroom_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/tmap_22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- 여자 화장실 -->
                    <LinearLayout
                        android:id="@+id/highway_item_female_restroom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/tmap_14dp"
                            android:layout_height="@dimen/tmap_14dp"
                            android:src="@drawable/girl_restroom_icon" />

                        <TextView
                            android:id="@+id/highway_item_female_restroom_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_2dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/tmap_13dp" />

                    </LinearLayout>

                    <!-- 남자 화장실 -->
                    <LinearLayout
                        android:id="@+id/highway_item_male_restroom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/tmap_4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/tmap_14dp"
                            android:layout_height="@dimen/tmap_14dp"
                            android:src="@drawable/boy_restroom_icon" />

                        <TextView
                            android:id="@+id/highway_item_male_restroom_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/tmap_2dp"
                            android:fontFamily="@font/skp_go_bm"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/tmap_13dp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

         